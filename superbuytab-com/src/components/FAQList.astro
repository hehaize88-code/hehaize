---
import Icon from './Icon.astro';
import {contentUI} from '../lib/content-ui';
const {items,lang='en'}=Astro.props;
const ui=contentUI(lang);
---
<div class="faq-list">{items.map((f:any)=><details id={f.id} class="faq-item"><summary><span>{f.q}</span><Icon name="plus" size={18}/></summary><div class="faq-answer"><p>{f.a}</p><a class="faq-source" href={f.source.url} target="_blank" rel="noopener noreferrer">{ui.official} · superbuy.com <Icon name="external" size={13}/></a></div></details>)}</div>
