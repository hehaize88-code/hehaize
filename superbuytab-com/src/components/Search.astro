---
import {localized,translate} from '../lib/i18n';
import Icon from './Icon.astro';
const {lang='en',query='',category='',sort='new',large=false}=Astro.props;
const t=translate(lang);
---
<form action={localized(lang,'/spreadsheet/')} method="get" class:list={['search-form',{large}]} role="search">
  <Icon name="search" size={22}/><input name="q" value={query} maxlength="120" placeholder={t.placeholder} aria-label={t.search}/>
  {category&&<input type="hidden" name="category" value={category}/>}
  {sort!=='new'&&<input type="hidden" name="sort" value={sort}/>}
  <a href={localized(lang,'/search/visual/')} class="visual-search" aria-label={t.visual} title={t.visual}><Icon name="image" size={22}/></a>
  <button type="submit">{t.search}<Icon name="arrow" size={18}/></button>
</form>
