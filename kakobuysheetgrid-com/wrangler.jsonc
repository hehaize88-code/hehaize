{
  "name": "kakobuysheetgrid-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {"directory":"dist/public","html_handling":"none","not_found_handling":"none"},
  "routes": [
    {"pattern": "kakobuysheetgrid.com", "custom_domain": true},
    {"pattern": "www.kakobuysheetgrid.com", "custom_domain": true}
  ],
  "build": {"command":"npm run build"}
}
