---
const {ui:u}=Astro.props;
---
<section class="weight-tool" aria-labelledby="weight-tool-title">
 <h2 id="weight-tool-title">{u.weightToolTitle}</h2>
 <p>{u.weightToolIntro}</p>
 <form data-weight-tool>
  <div class="weight-fields">
   <label>{u.actualWeight}<input name="actual" type="number" inputmode="decimal" min="0.001" step="any" value="3" required /></label>
   <label>{u.parcelLength}<input name="length" type="number" inputmode="decimal" min="0.001" step="any" value="40" required /></label>
   <label>{u.parcelWidth}<input name="width" type="number" inputmode="decimal" min="0.001" step="any" value="30" required /></label>
   <label>{u.parcelHeight}<input name="height" type="number" inputmode="decimal" min="0.001" step="any" value="20" required /></label>
   <label>{u.weightDivisor}<input name="divisor" type="number" inputmode="decimal" min="1" step="any" value="6000" required /></label>
   <label>{u.weightRule}<select name="rule"><option value="higher">{u.higherWeight}</option><option value="actual">{u.actualOnly}</option></select></label>
  </div>
  <button type="submit" class="button">{u.calculateWeight}</button>
  <div class="weight-result" aria-live="polite" aria-atomic="true">
   <p data-weight-error hidden>{u.weightError}</p>
   <div data-weight-values hidden><p>{u.volumetricWeight}: <strong data-volumetric></strong> kg</p><p>{u.billingBase}: <strong data-billing></strong> kg</p></div>
  </div>
 </form>
 <p class="fine-print">{u.weightDisclaimer}</p>
 <a class="text-link" href="https://blog.sugargoo.com/estimate-international-shipping-costs-sugargoo/" target="_blank" rel="noopener noreferrer">{u.officialEstimatorGuide} ↗</a>
</section>
<script>
import {parcelWeight} from '../lib/parcel-weight.js';
const form=document.querySelector<HTMLFormElement>('[data-weight-tool]');
form?.addEventListener('submit',event=>{
 event.preventDefault();
 const fields=new FormData(form);
 const result=parcelWeight({actual:Number(fields.get('actual')),length:Number(fields.get('length')),width:Number(fields.get('width')),height:Number(fields.get('height')),divisor:Number(fields.get('divisor')),rule:String(fields.get('rule'))});
 const error=form.querySelector<HTMLElement>('[data-weight-error]')!;
 const values=form.querySelector<HTMLElement>('[data-weight-values]')!;
 error.hidden=!!result;values.hidden=!result;
 if(result){
  const number=new Intl.NumberFormat(document.documentElement.lang,{maximumFractionDigits:3});
  form.querySelector('[data-volumetric]')!.textContent=number.format(result.volumetric);
  form.querySelector('[data-billing]')!.textContent=number.format(result.billing);
 }
});
</script>
