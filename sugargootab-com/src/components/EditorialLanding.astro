---
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import {localized} from '../lib/i18n';
const {ed,lang}=Astro.props; const u=ed.ui;const link=(p:string)=>localized(lang,p);
---
<section class="container editorial-home"><div class="section-heading"><div><span class="eyebrow">SUGARGOO / {u.articles}</span><h2>{u.homeTitle}</h2><p class="editorial-subtitle">{u.homeIntro}</p></div><a class="text-link" href={link('/articles/')}>{u.allArticles}<Icon name="arrow"/></a></div><div class="article-grid home-articles">{ed.articles.slice(0,4).map((article:any,index:number)=><ArticleCard {article} ui={u} {lang} {index}/>)}</div><a class="faq-home-link" href={link('/faq/')}><div><span class="eyebrow">{ed.faqs.length} {u.questionsCount}</span><h3>{u.homeFaq}</h3><p>{u.homeFaqIntro}</p></div><span>{u.allFaq}<Icon name="arrow"/></span></a></section>
