---
import ArticleCard from './ArticleCard.astro';
import WeightCalculator from './WeightCalculator.astro';
import {categoryNames} from '../lib/i18n';
import {slugs} from '../lib/catalog';
import Icon from './Icon.astro';
import {localized} from '../lib/i18n';
import {minutes,topic} from '../lib/editorial';
import {readingControls} from '../lib/reading-controls';
const {ed,lang,type,article,basePath=''}=Astro.props;const [expandAll,collapseAll]=readingControls(lang);const u=ed.ui;const link=(p:string)=>basePath+localized(lang,p);const reviewed=new Intl.DateTimeFormat(lang,{dateStyle:'medium',timeZone:'UTC'}).format(new Date((article?.updated||ed.reviewed)+'T12:00:00Z'));
const actionLabel=(path:string)=>path.startsWith('/articles/')?ed.articles.find((a:any)=>path==='/articles/'+a.slug+'/')?.title:path.startsWith('/category/')?categoryNames(lang)[slugs.indexOf(path.split('/')[2])]:u.catalogCtaButton;
---
{type==='articles'&&<section class="editorial-index"><div class="page-heading"><span class="eyebrow">SUGARGOO / {ed.articles.length} {u.articlesCount}</span><h1>{u.articleTitle}<span class="heading-dot">.</span></h1><p class="editorial-intro">{u.articleIntro}</p></div><div class="article-grid">{[...ed.articles].sort((a:any,b:any)=>b.published.localeCompare(a.published)).map((a:any,i:number)=><ArticleCard {basePath} article={a} ui={u} {lang} index={i}/>)}</div><div class="editorial-bottom"><p>{u.sourceNote}</p><a class="text-link" href={link('/faq/')}>{u.allFaq}<Icon name="arrow"/></a></div></section>}
{type==='faq'&&<section class="faq-page"><div class="page-heading"><span class="eyebrow">SUGARGOO / {ed.faqs.length} {u.questionsCount}</span><h1>{u.faqTitle}<span class="heading-dot">.</span></h1><p class="editorial-intro">{u.faqIntro}</p></div><div class="faq-tools"><div class="faq-search"><Icon name="search"/><input type="search" data-faq-search placeholder={u.faqSearch} aria-label={u.faqSearch}/></div><nav class="faq-topics" aria-label={u.allTopics}>{Object.entries(ed.groups).map(([id,label])=><a href={'#faq-'+id}>{label}</a>)}</nav></div><div class="faq-columns">{Object.entries(ed.groups).map(([id,label])=><section class="faq-group" id={'faq-'+id}><h2>{label}</h2>{ed.faqs.filter((f:any)=>f.group===id).map((f:any)=><details class="faq-item" id={'question-'+f.id} data-faq-item data-faq-text={f.question+' '+f.answer}><summary>{f.question}<Icon name="plus" size={17}/></summary><div class="faq-answer"><p>{f.answer}</p>{f.sources.length>0?<div class="faq-sources"><span>{u.sources}:</span>{f.sources.map((s:any,i:number)=><a href={s.url} target="_blank" rel="noopener noreferrer" title={s.title} aria-label={u.sources+': '+s.title}>{i+1}<Icon name="external" size={11}/></a>)}</div>:<span class="faq-source-note">{u.siteEvidence}</span>}</div></details>)}</section>)}</div><p hidden class="faq-empty" data-faq-empty>{u.noFaq}</p><div class="editorial-bottom"><p>{u.faqNote}</p><span>{u.reviewed} · {reviewed}</span></div></section>}
{type==='article'&&article&&<article class="editorial-article"><header class="article-heading"><span class="eyebrow">{topic(article.category,u)}</span><h1>{article.title}</h1><p class="article-deck">{article.description}</p><div class="article-byline"><span>{u.author}</span><span>{u.reviewed} · {reviewed}</span><span>{minutes(article)} {u.minutes}</span></div></header><div class="article-layout"><aside class="article-aside"><details class="article-toc" open><summary>{u.contents}<Icon name="chevron" size={15}/></summary><ol>{article.sections.map((s:any)=><li><a href={'#'+s.id}>{s.title.replace(/^\d+\.\s*/, '')}</a></li>)}<li><a href="#checklist">{u.checklist}</a></li><li><a href="#sources">{u.sources}</a></li></ol></details></aside><div class="article-body"><div class="reading-controls" hidden><button type="button" data-expand-reading>{expandAll}<Icon name="plus" size={14}/></button><button type="button" data-collapse-reading>{collapseAll}<Icon name="chevron" size={14}/></button></div><div class="article-intro">{article.intro.map((p:string)=><p>{p}</p>)}</div>{article.actions&&<nav class="article-next-step" aria-label={u.nextStep}><strong>{u.nextStep}</strong><div>{article.actions.map((path:string)=><a class="text-link" data-track={path.startsWith('/articles/')?'article_guide_click':'article_catalog_click'} data-destination={path} href={link(path)}>{actionLabel(path)}<Icon name="arrow" size={16}/></a>)}</div></nav>}{article.slug==='sugargoo-shipping-calculator'&&<WeightCalculator ui={u}/>}{article.sections.map((s:any)=><details class="article-section" id={s.id} open data-reading-section><summary><h2>{s.title}</h2><Icon name="chevron" size={17}/></summary><div class="chapter-body">{s.paragraphs.map((p:string)=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map((b:string)=><li>{b}</li>)}</ul>}{s.table&&<div class="article-table"><table><thead><tr>{s.table.headers.map((h:string)=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map((r:string[])=><tr>{r.map((c:string)=><td>{c}</td>)}</tr>)}</tbody></table></div>}</div></details>)}<details class="article-checklist" id="checklist" open data-reading-section><summary><h2>{u.checklist}</h2><Icon name="chevron" size={17}/></summary><div class="chapter-body"><ul>{article.checklist.map((p:string)=><li><Icon name="arrow" size={16}/><span>{p}</span></li>)}</ul></div></details><details class="article-sources" id="sources" open data-reading-section><summary><h2>{u.sources}</h2><Icon name="chevron" size={17}/></summary><div class="chapter-body"><p>{u.sourceNote}</p><ul>{article.sources.map((s:any)=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}<Icon name="external" size={13}/></a></li>)}</ul></div></details><aside class="article-catalog-cta" aria-label={u.catalogCtaTitle}><strong>{u.catalogCtaTitle}</strong><p>{u.catalogCtaBody}</p><div><a class="button" data-track="article_catalog_click" data-destination="spreadsheet" href={link('/spreadsheet/')}>{u.catalogCtaButton}<Icon name="arrow" size={17}/></a><a class="text-link" data-track="article_catalog_click" data-destination="categories" href={link('/categories/')}>{u.categoryCtaButton}<Icon name="arrow" size={16}/></a></div></aside><a class="text-link" href={link('/articles/')}><span>←</span>{u.backArticles}</a></div></div><section class="article-related"><h2>{u.related}</h2><div class="article-grid">{article.related.map((slug:string)=>ed.articles.find((a:any)=>a.slug===slug)).filter(Boolean).map((a:any,i:number)=><ArticleCard {basePath} article={a} ui={u} {lang} index={i}/>)}</div></section></article>}
<script>
const field=document.querySelector<HTMLInputElement>('[data-faq-search]');
const compactReading=window.matchMedia('(max-width: 760px)');
const sections=[...document.querySelectorAll<HTMLDetailsElement>('[data-reading-section]')];
const toc=document.querySelector<HTMLDetailsElement>('.article-toc');
const controls=document.querySelector<HTMLElement>('.reading-controls');
const revealAnchor=(hash:string,scroll=false)=>{
 let id='';try{id=decodeURIComponent(hash.replace(/^#/,''));}catch{return;}
 if(!id)return;
 const target=document.getElementById(id);
 const chapter=target?.closest<HTMLDetailsElement>('details[data-reading-section]');
 if(chapter)chapter.open=true;
 if(scroll&&target)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));
};
const applyReadingMode=()=>{
 sections.forEach((section,i)=>section.open=!compactReading.matches||i===0);
 if(toc)toc.open=!compactReading.matches;
 if(controls)controls.hidden=!compactReading.matches;
 revealAnchor(window.location.hash,Boolean(window.location.hash));
};
if(sections.length){
 applyReadingMode();compactReading.addEventListener('change',applyReadingMode);
 document.querySelector('[data-expand-reading]')?.addEventListener('click',()=>sections.forEach(s=>s.open=true));
 document.querySelector('[data-collapse-reading]')?.addEventListener('click',()=>sections.forEach(s=>s.open=false));
 document.querySelectorAll<HTMLAnchorElement>('.article-toc a[href^="#"]').forEach(a=>a.addEventListener('click',()=>{
  revealAnchor(a.hash);if(compactReading.matches&&toc)toc.open=false;
 }));
 window.addEventListener('hashchange',()=>revealAnchor(window.location.hash,true));
 let printState:boolean[]=[];
 window.addEventListener('beforeprint',()=>{printState=sections.map(s=>s.open);sections.forEach(s=>s.open=true);});
 window.addEventListener('afterprint',()=>sections.forEach((s,i)=>s.open=printState[i]??true));
}
if(field){const normalize=(v:string)=>v.toLocaleLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu,'');const update=()=>{const q=normalize(field.value.trim());let count=0;document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach(d=>{const match=normalize(d.dataset.faqText||'').includes(q);d.hidden=!match;if(match)count++;});document.querySelectorAll<HTMLElement>('.faq-group').forEach(g=>{g.hidden=![...g.querySelectorAll<HTMLElement>('[data-faq-item]')].some(d=>!d.hidden);});const empty=document.querySelector<HTMLElement>('[data-faq-empty]');if(empty)empty.hidden=count>0;};field.addEventListener('input',update);document.querySelectorAll<HTMLAnchorElement>('.faq-topics a').forEach(a=>a.addEventListener('click',()=>{field.value='';update();}));}
</script>
