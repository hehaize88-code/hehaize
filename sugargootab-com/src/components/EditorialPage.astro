---
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import {localized} from '../lib/i18n';
import {minutes,topic} from '../lib/editorial';
const {ed,lang,type,article,basePath=''}=Astro.props;const u=ed.ui;const link=(p:string)=>basePath+localized(lang,p);const reviewed=new Intl.DateTimeFormat(lang,{dateStyle:'medium',timeZone:'UTC'}).format(new Date(ed.reviewed+'T12:00:00Z'));
---
{type==='articles'&&<section class="editorial-index"><div class="page-heading"><span class="eyebrow">SUGARGOO / {ed.articles.length} {u.articlesCount}</span><h1>{u.articleTitle}<span class="heading-dot">.</span></h1><p class="editorial-intro">{u.articleIntro}</p></div><div class="article-grid">{ed.articles.map((a:any,i:number)=><ArticleCard {basePath} article={a} ui={u} {lang} index={i}/>)}</div><div class="editorial-bottom"><p>{u.sourceNote}</p><a class="text-link" href={link('/faq/')}>{u.allFaq}<Icon name="arrow"/></a></div></section>}
{type==='faq'&&<section class="faq-page"><div class="page-heading"><span class="eyebrow">SUGARGOO / {ed.faqs.length} {u.questionsCount}</span><h1>{u.faqTitle}<span class="heading-dot">.</span></h1><p class="editorial-intro">{u.faqIntro}</p></div><div class="faq-tools"><div class="faq-search"><Icon name="search"/><input type="search" data-faq-search placeholder={u.faqSearch} aria-label={u.faqSearch}/></div><nav class="faq-topics" aria-label={u.allTopics}>{Object.entries(ed.groups).map(([id,label])=><a href={'#faq-'+id}>{label}</a>)}</nav></div><div class="faq-columns">{Object.entries(ed.groups).map(([id,label])=><section class="faq-group" id={'faq-'+id}><h2>{label}</h2>{ed.faqs.filter((f:any)=>f.group===id).map((f:any)=><details class="faq-item" id={'question-'+f.id} data-faq-item data-faq-text={f.question+' '+f.answer}><summary>{f.question}<Icon name="plus" size={17}/></summary><div class="faq-answer"><p>{f.answer}</p>{f.sources.length>0?<div class="faq-sources"><span>{u.sources}:</span>{f.sources.map((s:any,i:number)=><a href={s.url} target="_blank" rel="noopener noreferrer" title={s.title} aria-label={u.sources+': '+s.title}>{i+1}<Icon name="external" size={11}/></a>)}</div>:<span class="faq-source-note">{u.siteEvidence}</span>}</div></details>)}</section>)}</div><p hidden class="faq-empty" data-faq-empty>{u.noFaq}</p><div class="editorial-bottom"><p>{u.faqNote}</p><span>{u.reviewed} · {reviewed}</span></div></section>}
{type==='article'&&article&&<article class="editorial-article"><header class="article-heading"><span class="eyebrow">{topic(article.category,u)}</span><h1>{article.title}</h1><p class="article-deck">{article.description}</p><div class="article-byline"><span>{u.author}</span><span>{u.reviewed} · {reviewed}</span><span>{minutes(article)} {u.minutes}</span></div></header><div class="article-layout"><aside class="article-aside"><details class="article-toc" open><summary>{u.contents}<Icon name="chevron" size={15}/></summary><ol>{article.sections.map((s:any)=><li><a href={'#'+s.id}>{s.title.replace(/^\d+\.\s*/, '')}</a></li>)}<li><a href="#checklist">{u.checklist}</a></li><li><a href="#sources">{u.sources}</a></li></ol></details></aside><div class="article-body"><div class="article-intro">{article.intro.map((p:string)=><p>{p}</p>)}</div>{article.sections.map((s:any)=><section class="article-section" id={s.id}><h2>{s.title}</h2>{s.paragraphs.map((p:string)=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map((b:string)=><li>{b}</li>)}</ul>}{s.table&&<div class="article-table"><table><thead><tr>{s.table.headers.map((h:string)=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map((r:string[])=><tr>{r.map((c:string)=><td>{c}</td>)}</tr>)}</tbody></table></div>}</section>)}<section class="article-checklist" id="checklist"><h2>{u.checklist}</h2><ul>{article.checklist.map((p:string)=><li><Icon name="arrow" size={16}/><span>{p}</span></li>)}</ul></section><section class="article-sources" id="sources"><h2>{u.sources}</h2><p>{u.sourceNote}</p><ul>{article.sources.map((s:any)=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}<Icon name="external" size={13}/></a></li>)}</ul></section><a class="text-link" href={link('/articles/')}><span>←</span>{u.backArticles}</a></div></div><section class="article-related"><h2>{u.related}</h2><div class="article-grid">{article.related.map((slug:string)=>ed.articles.find((a:any)=>a.slug===slug)).filter(Boolean).map((a:any,i:number)=><ArticleCard {basePath} article={a} ui={u} {lang} index={i}/>)}</div></section></article>}
<script>
const field=document.querySelector<HTMLInputElement>('[data-faq-search]');
if(window.matchMedia('(max-width: 760px)').matches)document.querySelectorAll<HTMLDetailsElement>('.article-toc').forEach(d=>d.open=false);
if(field){const normalize=(v:string)=>v.toLocaleLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu,'');const update=()=>{const q=normalize(field.value.trim());let count=0;document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach(d=>{const match=normalize(d.dataset.faqText||'').includes(q);d.hidden=!match;if(match)count++;});document.querySelectorAll<HTMLElement>('.faq-group').forEach(g=>{g.hidden=![...g.querySelectorAll<HTMLElement>('[data-faq-item]')].some(d=>!d.hidden);});const empty=document.querySelector<HTMLElement>('[data-faq-empty]');if(empty)empty.hidden=count>0;};field.addEventListener('input',update);document.querySelectorAll<HTMLAnchorElement>('.faq-topics a').forEach(a=>a.addEventListener('click',()=>{field.value='';update();}));}
</script>
