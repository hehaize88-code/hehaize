---
import '../styles/global.css';
import '../styles/directory.css';
import '../styles/commerce.css';
import '../styles/compact.css';
import {dictionary,localizedProduct,ui} from '../lib/commerce-locale';
import {renderProductDetail} from '../lib/product-detail';
import {localizeCatalogueHtml} from '../lib/localize-html';
import ImageSearch from '../components/ImageSearch.astro';
import {CURRENCIES} from '../../scripts/commerce-api.mjs';
import Pagination from '../components/Pagination.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import {SITE_ORIGIN,isProductionOrigin} from '../lib/site';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import EditorialPage from '../components/EditorialPage.astro';
import EditorialLanding from '../components/EditorialLanding.astro';
import {content} from '../lib/editorial';
import {languages,translate,categoryNames,localized} from '../lib/i18n';
import {editorial} from '../lib/copy';
import {home,listing,detail,slugs,LOGO,FAVICON,REGISTER} from '../lib/catalog';
const bits=Astro.url.pathname.split('/').filter(Boolean);
const basePath='';
let lang='en';
if(languages.some(l=>l[0]===bits[0])) lang=bits.shift()!;
const path='/'+bits.join('/')+(bits.length&&!bits.at(-1)?.includes('.')?'/':'');
const d=await dictionary(lang,Astro.locals.assets), u=ui(lang);
Astro.locals.commerceDictionary=d;
const tr=(text:string)=>d[text]||text;
const t=translate(lang), c=editorial(lang), names=categoryNames(lang);
c.priceNote=u.estimate;
c.qcNote=tr('These are catalogue reference photos; they are not identified as warehouse QC.');
const ed=content(lang);
const article=path.startsWith('/articles/')?ed.articles.find(a=>path==='/articles/'+a.slug+'/'):null;
const link=(p='/')=>basePath+localized(lang,p);
const q=(Astro.url.searchParams.get('q')||'').slice(0,100);
const sort=['new','click','price'].includes(Astro.url.searchParams.get('sort')||'')?Astro.url.searchParams.get('sort')!:'new';
const page=Math.max(1,Math.min(100000,parseInt(Astro.url.searchParams.get('page')||'1')||1));
const category=path.startsWith('/category/')?bits[1]:'';
let type=path==='/faq/'?'faq':path==='/articles/'?'articles':article?'article':path==='/'?'home':path==='/spreadsheet/'?'listing':path==='/categories/'?'categories':path==='/guide/'?'guide':path==='/qc/'?'qc':path==='/search/visual/'?'visual':/^\/category\/[a-z-]+\/$/.test(path)&&slugs.includes(category)?'listing':/^\/products\/[a-z-]+\/\d+\.html$/.test(path)?'detail':'404';
let data:any=null,error='',status=type==='404'?404:200;
try {
 if(type==='home'||type==='categories')data=await home();
 if(type==='listing'){
  data=await listing(category,q,sort,page);
  if(page>data.pages)return Astro.redirect(pageURL(data.pages),302);
 }
 if(type==='detail')data=await detail(path.slice('/products'.length));
} catch(e:any){error=c.error;status=e.status===404?404:503;console.error('Catalogue read failed',e.message);}
Astro.response.status=status;
const indexable=isProductionOrigin(Astro.url)&&status===200&&!q&&!(type==='listing'&&(page>1||sort!=='new'))&&type!=='visual';
const robots=indexable?'index,follow,max-image-preview:large':'noindex,follow';
Astro.response.headers.set('X-Robots-Tag',robots);
Astro.response.headers.set('Cache-Control','no-store');
const activeCategory=category?names[slugs.indexOf(category)]:'';
const listingTitle=category?ed.ui.seoCategoryTitle.replace('{category}',activeCategory):ed.ui.seoCatalogTitle;
const listingDescription=category?ed.ui.seoCategoryDescription.replace('{category}',activeCategory):ed.ui.seoCatalogDescription;
const title=type==='faq'?ed.ui.faqTitle:type==='articles'?ed.ui.articleTitle:type==='article'?article!.title:type==='home'?ed.ui.seoHomeTitle:type==='detail'&&data?localizedProduct(data.title,lang,d):type==='listing'?listingTitle:type==='categories'?t.categories:type==='guide'?t.guide:type==='qc'?t.photos:type==='visual'?t.visual:'404';
const canonical=new URL(localized(lang,path),SITE_ORIGIN).href;
const description=type==='detail'&&data?`${localizedProduct(data.title,lang,d)} · ${t.photos} · ${t.price}`:type==='article'?article!.description:type==='articles'?ed.ui.articleIntro:type==='faq'?ed.ui.faqIntro:type==='home'?ed.ui.seoHomeDescription:type==='listing'?listingDescription:c.intro;
const entity=type==='detail'&&data?{'@context':'https://schema.org','@type':'Product',name:localizedProduct(data.title,lang,d),description,sku:data.sourceId,image:data.images,url:canonical}:type==='article'?{'@context':'https://schema.org','@type':'Article',headline:article!.title,description:article!.description,datePublished:article!.published,dateModified:article!.updated,inLanguage:lang,mainEntityOfPage:canonical,author:{'@type':'Organization',name:ed.ui.author},publisher:{'@type':'Organization',name:'SugargooTab'},citation:article!.sources.map(s=>s.url)}:type==='faq'?{'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:ed.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}:null;
function pageURL(n:number){const p=new URLSearchParams({sort,page:String(n)});if(q)p.set('q',q);return link(path)+'?'+p.toString();}
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <GoogleAnalytics />
  <title>{type==='home'||type==='article'||type==='listing'?title:`${title} | Sugargoo Spreadsheet`}</title>
  <meta name="description" content={description}/><meta name="robots" content={robots}/>
  <link rel="canonical" href={canonical}/><link rel="icon" href={FAVICON}/>
  {languages.map(([code])=><link rel="alternate" hreflang={code} data-locale-code={code} href={new URL(localized(code,path),SITE_ORIGIN).href}/>)}
  <link rel="alternate" hreflang="x-default" href={new URL(path,SITE_ORIGIN).href}/>
  <meta name="theme-color" content="#ff6337"/>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Sugargoo Spreadsheet',url:SITE_ORIGIN,inLanguage:lang}).replace(/</g,String.fromCharCode(92)+'u003c')}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={type==='article'?'article':'website'}/>
  {entity&&<script type="application/ld+json" set:html={JSON.stringify(entity).replace(/</g,String.fromCharCode(92)+'u003c')}/>}
 </head>
 <body data-page-type={type} data-locale={lang} data-article={article?.slug} data-search-active={Boolean(q)} data-result-count={data?.total ?? undefined}>
  <header class="site-header">
   <div class="header-inner">
    <a href={link()} class="brand" aria-label="Sugargoo Spreadsheet"><img src={LOGO} alt="SUGARGOO" width="170" height="40"/><span class="brand-tab">TAB</span></a>
    <nav aria-label={t.browse}>
     <a class:list={{active:type==='listing'}} href={link('/spreadsheet/')}>{t.browse}</a>
     <a class:list={{active:type==='visual'}} href={link('/search/visual/')}>{t.visual}</a>
     <a class:list={{active:type==='categories'}} href={link('/categories/')}>{t.categories}</a>
     <a class:list={{active:type==='guide'}} href={link('/guide/')}>{t.guide}</a>
     <a class:list={{active:type==='qc'}} href={link('/qc/')}>{ed.ui.navQc}</a>
     <a class:list={{active:article?.slug==='sugargoo-shipping-calculator'}} href={link('/articles/sugargoo-shipping-calculator/')}>{ed.ui.navShipping}</a>
     <a class:list={{active:type==='faq'}} href={link('/faq/')}>{t.faq}</a>
     <a class:list={{active:type==='articles'||type==='article'}} href={link('/articles/')}>{ed.ui.articles}</a>
    </nav>
    <div class="header-actions">
     <label class="currency-control"><span class="sr-only">{u.currency}</span><select data-currency-select aria-label={u.currency}>{CURRENCIES.map(code=><option value={code}>{code}</option>)}</select></label>
     <details class="language-select"><summary aria-label={t.language}><Icon name="globe" size={18}/><span>{lang.toUpperCase()}</span><Icon name="chevron" size={14}/></summary><div class="language-menu"><p>{t.language}</p>{languages.map(([code,label])=><a class:list={{selected:lang===code}} lang={code} data-locale-code={code} href={basePath+localized(code,path)+Astro.url.search}>{label}<span>{code.toUpperCase()}</span></a>)}</div></details>
     <a class="button button-small join" data-track="outbound_register_click" data-destination="sugargoo" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external" size={15}/></a>
    </div>
   </div>
  </header>
  <main>
   {type==='home'&&<>
    <section class="directory-hero"><div class="container">
     <div class="directory-kicker"><span><span class="orange-dot"></span>SUGARGOOTAB</span><span>{t.browse} / 2026</span></div>
     <h1>Sugargoo <em>{t.browse}.</em></h1>
     <div class="directory-intro"><p>{ed.ui.homeSearchIntro}</p><a href={link('/guide/')} class="directory-guide-link">{t.guide}<Icon name="external" size={20}/></a></div>
     <form class="directory-search" data-image-search-target action={link('/spreadsheet/')} method="get"><Icon name="search" size={24}/><input type="search" name="q" aria-label={t.search} placeholder={t.placeholder}/><a class="search-camera" href={link('/search/visual/')} data-image-search-trigger aria-label={t.visual} title={t.visual} aria-haspopup="dialog"><Icon name="camera" size={24}/></a><button type="submit">{t.search}<Icon name="arrow" size={20}/></button></form>
     <nav class="hero-shortcuts" aria-label={t.categories}><a class="button" href={link('/spreadsheet/')}>{ed.ui.catalogCtaButton}<Icon name="arrow" size={17}/></a>{['shoes','hoodies-sweaters','jersey'].map(slug=><a class="text-link" href={link('/category/'+slug+'/')}>{names[slugs.indexOf(slug)]}<Icon name="arrow" size={15}/></a>)}</nav><div class="directory-metadata"><span>01 — {t.search}</span><span>02 — {t.photos}</span><span>03 — Sugargoo</span></div>
    </div></section>
    <div class="container directory-layout">
     <aside class="directory-sidebar">
      <div class="sidebar-heading"><span>{t.categories}</span><span>{slugs.length}</span></div>
      <nav class="directory-categories" aria-label={t.categories}><a class="current" href={link('/spreadsheet/')}><span class="category-no">↗</span><span>{t.all}</span><Icon name="arrow" size={16}/></a>{slugs.map((slug,i)=><a href={link('/category/'+slug+'/')}><span class="category-no">{String(i+1).padStart(2,'0')}</span><span>{names[i]}</span></a>)}</nav>
      <a class="sidebar-reading" href={link('/faq/')}><span>{ed.faqs.length} / {t.faq}</span><strong>{ed.ui.homeFaq}</strong><Icon name="arrow" size={22}/></a>
     </aside>
     <section class="directory-feed"><div class="section-heading"><div><span class="eyebrow">Sugargoo / {t.latest}</span><h2>{t.latest}</h2></div><a class="text-link" href={link('/spreadsheet/')}>{t.all}<Icon name="arrow"/></a></div>
      {data?<div class="product-grid home-grid">{data.products.slice(0,12).map((p:any,i:number)=><Card {basePath} product={p} t={t} names={names} lang={lang} eager={i<4}/>)}</div>:<p class="notice">{error}</p>}
      <a class="catalog-more" href={link('/spreadsheet/')}><span>{t.browse}</span><Icon name="arrow" size={22}/></a>
     </section>
    </div>
    <section class="guide-band"><div class="container guide-grid"><div><span class="eyebrow">SUGARGOO / {t.guide}</span><h2>{c.howTitle}</h2></div><div><p>{c.how}</p><a class="text-link" href={link('/guide/')}>{t.guide}<Icon name="arrow"/></a></div></div></section>
    <EditorialLanding {ed} {lang} {basePath}/>
   </>}
   {type!=='home'&&<div class="container inner-page">
    <div class="breadcrumb"><a href={link()}>{t.home}</a><span>/</span>{type==='article'&&<><a href={link('/articles/')}>{ed.ui.articles}</a><span>/</span></>}<span>{type==='detail'?t.view:title}</span></div>
    {type==='listing'&&<>
     <div class="catalog-heading"><div><span class="eyebrow">SUGARGOOTAB / {t.browse}</span><h1>{activeCategory||ed.ui.seoCatalogTitle}</h1></div><a class="text-link" href={link('/guide/')}>{t.guide}<Icon name="external" size={17}/></a></div>
     <div class="catalog-guidance"><p>{listingDescription}</p><p class="fine-print">{ed.ui.catalogGuideNote}</p><nav>{(category==='shoes'?['sugargoo-shoe-size-guide','sugargoo-qc-photos']:['hoodies-sweaters','t-shirts','jackets','pants-shorts','short-sets','jersey'].includes(category)?['sugargoo-clothing-size-guide','sugargoo-finds-under-20']:['sugargoo-spreadsheet-guide','sugargoo-finds-under-20']).map(slug=><a class="text-link" href={link('/articles/'+slug+'/')}>{ed.articles.find(a=>a.slug===slug)?.title}<Icon name="arrow" size={15}/></a>)}</nav></div><div class="catalog-workspace">
      <aside class="directory-sidebar catalog-sidebar"><div class="sidebar-heading"><span>{t.categories}</span><span>{slugs.length}</span></div><nav class="directory-categories" aria-label={t.categories}><a class:list={{current:!category}} href={link('/spreadsheet/')+(q?'?q='+encodeURIComponent(q):'')}><span class="category-no">↗</span><span>{t.all}</span></a>{slugs.map((s,i)=><a class:list={{current:s===category}} href={link('/category/'+s+'/')+(q?'?q='+encodeURIComponent(q):'')}><span class="category-no">{String(i+1).padStart(2,'0')}</span><span>{names[i]}</span></a>)}</nav></aside>
      <section class="catalog-results">
       <form class="catalog-toolbar" action={link(path)} method="get">
        <div class="input-wrap" data-image-search-target><Icon name="search"/><input type="search" name="q" value={q} placeholder={t.placeholder} aria-label={t.search}/><a class="search-camera" href={link('/search/visual/')} data-image-search-trigger aria-label={t.visual} title={t.visual} aria-haspopup="dialog"><Icon name="camera" size={24}/></a></div>
        <select name="sort" aria-label={t.popular}><option value="new" selected={sort==='new'}>{t.latest}</option><option value="click" selected={sort==='click'}>{t.popular}</option><option value="price" selected={sort==='price'}>{t.priceSort}</option></select>
        <button class="button" type="submit">{t.search}<Icon name="arrow" size={18}/></button>
       </form>
       {data&&<><div class="results-line"><span>{data.total>0&&`${data.start}–${data.end} / `}{data.total} {t.results}{q&&` · “${q}”`}</span>{q&&<a href={link(path)}>{t.clear} ×</a>}</div><div class="product-grid">{data.products.map((p:any,i:number)=><Card {basePath} product={p} t={t} names={names} lang={lang} eager={i<4}/>)}</div>{data.products.length===0&&<div class="empty-state"><Icon name="search" size={36}/><p>{t.empty}</p></div>}<Pagination {page} pages={data.pages} {t} urlFor={pageURL}/></>}
      </section>
     </div>
    </>}
    {type==='categories'&&<><div class="page-heading"><span class="eyebrow">Sugargoo / {t.browse}</span><h1>{t.categories}<span class="heading-dot">.</span></h1></div><div class="category-grid">{(data?.categories||[]).map((cat:any,i:number)=><a href={link('/category/'+cat.slug+'/')}><span class="category-index">{String(i+1).padStart(2,'0')}</span><h2>{names[slugs.indexOf(cat.slug)]}</h2><span>{cat.count} {t.results}</span><Icon name="arrow"/></a>)}</div></>}
    {type==='detail'&&data&&<>
      <div set:html={localizeCatalogueHtml(renderProductDetail({...data,title:localizedProduct(data.title,lang,d)},lang,t,data.buy),d,lang)} />
      {data.related.length>0&&<section class="product-section"><h2>{t.related}</h2><div class="product-grid">{data.related.map((p:any)=><Card {basePath} product={p} t={t} names={names} lang={lang}/>)}</div></section>}
    </>}
    {['faq','articles','article'].includes(type)&&<EditorialPage {ed} {lang} {basePath} {type} {article} {d}/>}
    {(type==='guide'||type==='qc')&&<section class="reading-page"><span class="eyebrow">SUGARGOO / {t.guide}</span><h1>{type==='guide'?c.howTitle:title}</h1>
     {type==='guide'&&<><p class="lead">{c.how}</p><div class="reading-block"><span>01</span><div><h2>{t.catalog}</h2><p>{c.intro}</p><a class="text-link" href={link('/spreadsheet/')}>{t.browse}<Icon name="arrow"/></a></div></div><div class="reading-block"><span>02</span><div><h2>{t.photos}</h2><p>{c.qcNote}</p></div></div><div class="reading-block"><span>03</span><div><h2>{t.price}</h2><p>{c.priceNote}</p></div></div><a class="button" data-track="outbound_register_click" data-destination="sugargoo" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external"/></a></>}
     {type==='qc'&&<><p class="lead">{c.qcNote}</p><nav class="article-next-step" aria-label={ed.ui.nextStep}><strong>{ed.ui.nextStep}</strong><div>{['sugargoo-qc-photos','sugargoo-clothing-size-guide','sugargoo-shoe-size-guide'].map(slug=><a class="text-link" href={link('/articles/'+slug+'/')}>{ed.articles.find(a=>a.slug===slug)?.title}<Icon name="arrow" size={16}/></a>)}</div></nav><a class="button" href={link('/spreadsheet/')}>{t.browse}<Icon name="arrow"/></a></>}
     {type==='visual'&&<><div class="image-search-state"><Icon name="image" size={40}/><p>{c.visualNote}</p></div><form class="search-form" action={link('/spreadsheet/')} method="get"><Icon name="search"/><input name="q" aria-label={t.search} placeholder={t.placeholder}/><button type="submit" aria-label={t.search}><Icon name="arrow"/></button></form></>}
    </section>}
    {type==='visual'&&<ImageSearch {lang} {t} {d}/>}
    {error&&<section class="empty-state"><Icon name="image" size={36}/><h2>{t.unavailable}</h2><p>{error}</p><a class="button" href={Astro.url.href}>{t.retry}<Icon name="arrow"/></a></section>}
    {type==='404'&&<section class="empty-state"><span class="error-number">404</span><h1>{t.unavailable}</h1><a class="button" href={link()}>{t.home}<Icon name="arrow"/></a></section>}
   </div>}
   {['home','listing'].includes(type)&&<dialog class="image-search-dialog" id="image-search-dialog" aria-labelledby="image-dialog-title"><div class="image-dialog-heading"><h2 id="image-dialog-title">{t.visual}</h2><form method="dialog"><button class="image-dialog-close" aria-label={u.close} title={u.close}>×</button></form></div><ImageSearch {lang} {t} {d} embedded/></dialog>}
  </main>
  <script type="module" src="/assets/experience.js?v=20261111-sugar-3" is:inline></script>
  <footer class="site-footer"><div class="container footer-top"><a href={link()} class="brand"><img src={LOGO} alt="SUGARGOO" width="150" height="35"/><span class="brand-tab">TAB</span></a><p>{c.disclosure}</p><div><a href={link('/spreadsheet/')}>{t.browse}</a><a href={link('/guide/')}>{t.guide}</a><a href={link('/qc/')}>{ed.ui.navQc}</a><a href={link('/articles/sugargoo-shipping-calculator/')}>{ed.ui.navShipping}</a><a href={link('/faq/')}>{t.faq}</a><a href={link('/articles/')}>{ed.ui.articles}</a></div></div><div class="container footer-bottom"><span>© 2026 Sugargoo Spreadsheet</span><span>SugargooTab</span></div></footer>
  <script>
   const main=document.querySelector<HTMLImageElement>('#main-image');
   const thumbnails=document.querySelectorAll<HTMLButtonElement>('.thumbnails button');
   thumbnails.forEach(b=>b.addEventListener('click',()=>{if(main&&b.dataset.image){main.src=b.dataset.image;thumbnails.forEach(x=>x.classList.toggle('chosen',x===b));}}));
   document.addEventListener('click',e=>{document.querySelectorAll<HTMLDetailsElement>('.language-select[open]').forEach(d=>{if(!d.contains(e.target as Node))d.open=false;});});
   document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll<HTMLDetailsElement>('.language-select[open]').forEach(d=>d.open=false);});
  </script>
 </body>
</html>

