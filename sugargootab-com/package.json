{
  "name": "sugargootab-com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4173",
    "build": "astro build && node scripts/finalize.mjs",
    "check:content": "node scripts/check-editorial.mjs",
    "check:routes": "node scripts/check-editorial-routes.mjs && node scripts/check-production.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "7.4.0",
    "linkedom": "0.18.12"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "wrangler": "4.151.1"
  }
}
