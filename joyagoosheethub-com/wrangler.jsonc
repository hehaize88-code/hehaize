{
  "name": "joyagoosheethub-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "build": {"command":"node build.mjs"},
  "assets": {"directory":"public","binding":"ASSETS"},
  "routes": [
    {"pattern":"joyagoosheethub.com","custom_domain":true},
    {"pattern":"www.joyagoosheethub.com","custom_domain":true}
  ]
}
