# Cache content-hashed assets immutably (generated by vinext)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache self-hosted product images while allowing scheduled catalog refreshes.
/product-images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Keep crawler files static, explicit, and consistent across request methods.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/sitemap.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
