---
import Icon from "./Icon.astro";
import { formatPrice } from "../lib/catalog";
import { localized } from "../lib/i18n";
import { productRoute } from "../lib/content";
const { product: p, lang, t, priority = false } = Astro.props;
---

<article class="product-card">
  <a
    href={localized(lang, productRoute(p.path))}
    class="product-image"
    aria-label={p.title}
  >
    {p.image ? (
      <img
        src={p.image}
        alt={p.title}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        referrerpolicy="no-referrer"
        width="400"
        height="400"
      />
    ) : (
      <span>{t.photoMissing}</span>
    )}
    <span class="product-arrow">
      <Icon size={18} />
    </span>
  </a>
  <div class="product-meta">
    <span>{p.categoryLabel || p.category.replaceAll("-", " ")}</span>
    <b>{formatPrice(p.price, lang)}</b>
  </div>
  <h3>
    <a href={localized(lang, productRoute(p.path))}>{p.title}</a>
  </h3>
</article>
