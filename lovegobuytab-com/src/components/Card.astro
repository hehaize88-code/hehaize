---
import Icon from "./Icon.astro";
import Price from "./Price.astro";
import { productTitle } from "../lib/product-title";
import { localized } from "../lib/i18n";
import { productRoute } from "../lib/content";
const { product: p, lang, t, priority = false } = Astro.props;
const title = productTitle(p.title, lang);
---

<article class="product-card">
  <a
    href={localized(lang, productRoute(p.path))}
    class="product-image"
    aria-label={title}
  >
    {p.image ? (
      <img
        src={p.image}
        alt={title}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        referrerpolicy="no-referrer"
        width="400"
        height="400"
      />
    ) : (
      <span>{t.photoMissing}</span>
    )}
    <span class="product-arrow">
      <Icon size={18} />
    </span>
  </a>
  <div class="product-meta">
    <span>{p.categoryLabel || p.category.replaceAll("-", " ")}</span>
    <b>
      <Price price={p.price} lang={lang} />
    </b>
  </div>
  <h3>
    <a href={localized(lang, productRoute(p.path))}>{title}</a>
  </h3>
</article>
