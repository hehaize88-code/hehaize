{
  "keep_names": false,
  "name": "superbuysheetindex-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-01",
  "build": {
    "command": "node build.mjs"
  },
  "routes": [
    {
      "pattern": "superbuysheetindex.com",
      "custom_domain": true
    },
    {
      "pattern": "www.superbuysheetindex.com",
      "custom_domain": true
    }
  ]
}
