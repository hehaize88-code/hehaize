---
import Icon from '../components/Icon.astro';
import Card from '../components/Card.astro';
import {languages,translate,categoryNames,localized} from '../lib/i18n';
import {editorial} from '../lib/copy';
import {home,listing,detail,slugs,LOGO,FAVICON,REGISTER} from '../lib/catalog';
import '../styles/global.css';
const parts=Astro.url.pathname.split('/').filter(Boolean);
const lang=languages.some(([code])=>code===parts[0]) ? parts.shift()! : 'en';
const localPath='/'+parts.join('/')+(parts.length&&!parts.at(-1)!.includes('.')?'/':'');
const t=translate(lang), c=editorial(lang), names=categoryNames(lang);
const query=(Astro.url.searchParams.get('q')||'').slice(0,120);
const sort=['new','click','price'].includes(Astro.url.searchParams.get('sort')||'')?Astro.url.searchParams.get('sort')!:'new';
const page=Math.max(1,Math.min(500,parseInt(Astro.url.searchParams.get('page')||'1')||1));
const category=parts[0]==='category'&&slugs.includes(parts[1])?parts[1]:'';
const isHome=parts.length===0, isProduct=parts[0]==='products', isVisual=parts[0]==='image-search';
const known=isHome||isProduct||isVisual||parts[0]==='spreadsheet'||!!category;
if(!known) Astro.response.status=404;
let products:any[]=[],categories:any[]=[],total=0,pages=1,product:any=null,error=false,debug='';
try {
  if(isHome){const data=await home();products=data.products.slice(0,12);categories=data.categories;total=categories.reduce((sum,item)=>sum+item.count,0);}
  else if(isProduct) product=await detail('/'+parts.slice(1).join('/'));
  else if(!isVisual&&known){const data=await listing(category,query,sort,page);({products,total,pages}=data);}
} catch(e){error=true;Astro.response.status=503;debug=e instanceof Error?e.message:'error';console.error('CnBuyCha request unavailable:',debug);}
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
const title=product?.title|| (isVisual?t.visual:category?names[slugs.indexOf(category)]:query?`${t.search}: ${query}`:'Kakobuy Spreadsheet');
const origin=Astro.site!.origin;
const route=(path:string)=>localized(lang,path);
const state=(changes:Record<string,string|number>)=>{const p=new URLSearchParams(Astro.url.search);for(const [key,value] of Object.entries(changes)){if(value==='')p.delete(key);else p.set(key,String(value));}return p.size?'?'+p.toString():'';};
const icons=['shoe','shirt','shirt','jacket','pants','hat','bag','shirt','device','box','shirt'];
---
<!doctype html>
<html lang={lang}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Kakobuy Finds</title><meta name="description" content={c.intro}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#fc3358"/><link rel="icon" href={FAVICON}/><link rel="canonical" href={origin+route(localPath)}/>{languages.map(([code])=><link rel="alternate" hreflang={code} href={origin+localized(code,localPath)}/>)}<link rel="alternate" hreflang="x-default" href={origin+localPath}/><link rel="preconnect" href="https://cnbuycha.com"/><link rel="preconnect" href="https://nstatic.kakobuy.com"/></head>
<body>
<header class="header"><div class="header-inner">
  <a href={route('/')} class="brand" aria-label={`Kakobuy ${t.home}`}><img src={LOGO} alt="Kakobuy" width="143" height="36"/><span>Spreadsheet</span></a>
  <nav class="nav" aria-label={t.browse}><a class:list={{active:isHome}} href={route('/')}>{t.home}</a><a class:list={{active:!isHome&&!isVisual}} href={route('/spreadsheet/')}>{t.browse}</a><a href={route('/')+'#guide'}>{t.guide}</a><a href={route('/')+'#faq'}>{t.faq}</a></nav>
  <div class="header-actions"><details class="language-menu"><summary aria-label={t.language}><Icon name="globe" size={18}/><span>{lang.toUpperCase()}</span><Icon name="chevron" size={13}/></summary><div class="language-panel"><div class="language-title">{t.language}<span>24</span></div><div class="language-grid">{languages.map(([code,name])=><a lang={code} hreflang={code} class:list={{selected:code===lang}} href={localized(code,localPath)+Astro.url.search}>{name}<span>{code.toUpperCase()}</span></a>)}</div></div></details><a class="button primary join" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external" size={15}/></a></div>
</div></header>
<main>
{isHome && <section class="hero wrap"><div class="hero-copy"><span class="eyebrow"><span class="red-dot"></span>{c.tagline}</span><h1>Kakobuy <em>Spreadsheet.</em></h1><p>{c.intro}</p></div><div class="hero-search"><form class="search-form" action={route('/spreadsheet/')}><Icon name="search" size={22}/><input name="q" type="search" placeholder={t.placeholder} aria-label={t.search}/><button class="search-submit" aria-label={t.search}><Icon name="arrow"/></button></form><div class="search-subline"><span>{t.photos} <i>·</i> USD <i>·</i> 24 {t.language.toLowerCase()}</span><a href={route('/image-search/')}><Icon name="camera" size={16}/>{t.visual}</a></div></div></section>}
{!isHome&&!isProduct&&!isVisual&&<section class="list-intro wrap"><a class="breadcrumb" href={route('/')}>{t.home} / {t.browse}</a><h1>{title}</h1><form class="search-form" action={route(category?`/category/${category}/`:'/spreadsheet/')}><Icon name="search"/><input name="q" type="search" value={query} placeholder={t.placeholder} aria-label={t.search}/><input type="hidden" name="sort" value={sort}/><button class="search-submit" aria-label={t.search}><Icon name="arrow"/></button></form></section>}
{!isProduct&&!isVisual&&known&&<section class="catalog wrap" id="products">
  <nav class="category-strip" aria-label={t.categories}><a href={route('/spreadsheet/')+state({page:'',q:query})} class:list={{selected:!category}}><Icon name="grid" size={18}/>{t.all}</a>{slugs.map((slug,i)=><a class:list={{selected:category===slug}} href={route(`/category/${slug}/`)+state({page:''})}><Icon name={icons[i]} size={18}/>{names[i]}</a>)}</nav>
  <div class="section-heading"><div><span class="eyebrow muted">{isHome?t.catalog:t.browse}</span><h2>{isHome?t.latest:query?`“${query}”`:category?names[slugs.indexOf(category)]:t.all}</h2></div>{isHome?<a class="text-link" href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={18}/></a>:<form class="sort-form" method="get"><input type="hidden" name="q" value={query}/><span class="results">{total.toLocaleString(lang)} {t.results}</span><select name="sort" aria-label={t.priceSort} onchange="this.form.requestSubmit()"><option value="new" selected={sort==='new'}>{t.latest}</option><option value="click" selected={sort==='click'}>{t.popular}</option><option value="price" selected={sort==='price'}>{t.priceSort}</option></select><noscript><button type="submit">{t.search}</button></noscript></form>}</div>
  {error?<div class="empty-state"><Icon name="box" size={32}/><h2>{t.unavailable}</h2><p>{c.error}</p><a class="button primary" href={route(localPath)+Astro.url.search}>{t.retry}</a></div>:products.length?<div class="product-grid">{products.map(p=><Card product={p} t={t} names={names} lang={lang}/>)}</div>:<div class="empty-state"><Icon name="search" size={32}/><h2>{t.empty}</h2><a class="button outline" href={route('/spreadsheet/')}>{t.clear}</a></div>}
  {!isHome&&pages>1&&!error&&<nav class="pagination" aria-label={t.browse}>{page>1?<a class="button outline" href={route(localPath)+state({page:page-1})}>← {t.previous}</a>:<span/>}<span>{page} / {pages}</span>{page<pages?<a class="button outline" href={route(localPath)+state({page:page+1})}>{t.next} →</a>:<span/>}</nav>}
  {isHome&&!error&&<div class="more"><a class="button outline" href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={18}/></a></div>}
</section>}
{isProduct&&<section class="product-page wrap"><a class="breadcrumb" href={route('/spreadsheet/')}>← {t.back}</a>{product?<><div class="product-detail"><div class="gallery"><a class="main-photo" id="photo-link" href={product.images[0]} target="_blank" rel="noopener noreferrer"><span class="missing-image">{t.photoMissing}</span>{product.images[0]&&<img id="main-photo" src={product.images[0]} alt={product.title} width="800" height="800" fetchpriority="high" referrerpolicy="no-referrer" onerror="this.style.display='none'"/>}<span class="photo-count"><span id="photo-current">1</span> / {product.images.length}</span></a><div class="thumbnails">{product.images.map((img:string,i:number)=><button type="button" data-photo={img} data-index={i+1} aria-label={`${t.photos} ${i+1}`} aria-pressed={i===0} class:list={{selected:i===0}}><img src={img} alt={`${product.title} ${i+1}`} width="80" height="80" loading="lazy" referrerpolicy="no-referrer"/></button>)}</div></div><div class="detail-info"><span class="eyebrow muted">{names[slugs.indexOf(product.category)]}</span><h1>{product.title}</h1><span class="source-id">ID · {product.sourceId}</span><div class="detail-price"><span>{t.price}</span><strong>${product.price} <small>USD</small></strong></div><p class="price-note">{c.priceNote}</p>{product.buy&&<a class="button primary purchase" href={product.buy} target="_blank" rel="sponsored nofollow noopener noreferrer">{t.buy}<Icon name="external" size={19}/></a>}{product.sourceUrl&&<a class="button outline purchase" href={product.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">{t.source}<Icon name="external" size={17}/></a>}<div class="detail-note"><Icon name="camera"/><div><h3>{t.photos}</h3><p>{c.qcNote}</p></div></div>{product.description&&<p class="source-description">{product.description}</p>}</div></div>{product.related.length>0&&<><div class="section-heading"><h2>{t.related}</h2></div><div class="product-grid">{product.related.map((p:any)=><Card product={p} t={t} names={names} lang={lang}/>)}</div></>}</>:<div class="empty-state"><h1>{t.unavailable}</h1><p>{c.error}</p><a class="button primary" href={route(localPath)}>{t.retry}</a></div>}</section>}
{isVisual&&<section class="visual-page wrap"><a class="breadcrumb" href={route('/')}>← {t.home}</a><div class="visual-box"><div class="icon-disc"><Icon name="camera" size={32}/></div><span class="status-pill">{t.unavailable}</span><h1>{t.visual}</h1><p>{c.visualNote}</p><form class="search-form" action={route('/spreadsheet/')}><Icon name="search"/><input type="search" name="q" placeholder={t.placeholder} aria-label={t.search}/><button class="search-submit" aria-label={t.search}><Icon name="arrow"/></button></form></div></section>}
{!known&&<section class="empty-state wrap"><h1>404</h1><a class="button primary" href={route('/')}>{t.home}</a></section>}
{isHome&&<><section id="guide" class="guide-section"><div class="wrap guide-inner"><div><span class="eyebrow">KAKOBUY SPREADSHEET</span><h2>{c.howTitle}</h2><a class="text-link" href={route('/spreadsheet/')}>{t.browse}<Icon name="arrow"/></a></div><div class="guide-content"><p>{c.how}</p><div class="steps"><span><b>01</b>{t.search}</span><span><b>02</b>{t.photos}</span><span><b>03</b>{t.buy}</span></div></div></div></section><section id="faq" class="faq-section wrap"><div><span class="eyebrow muted">KAKOBUY SPREADSHEET</span><h2>{t.faq}</h2></div><div class="faq-items"><details open><summary>{t.price}<span>+</span></summary><p>{c.priceNote}</p></details><details><summary>{t.photos}<span>+</span></summary><p>{c.qcNote}</p></details><details><summary>{t.visual}<span>+</span></summary><p>{c.visualNote}</p></details></div></section></>}
</main>
<footer><div class="wrap footer-inner"><div class="footer-brand"><a class="brand" href={route('/')}><img src={LOGO} alt="Kakobuy" width="130" height="33"/><span>Spreadsheet</span></a><p>{c.disclosure}</p></div><div class="footer-links"><a href={route('/spreadsheet/')}>{t.browse}</a><a href={route('/')+'#guide'}>{t.guide}</a><a href={route('/')+'#faq'}>{t.faq}</a></div></div><div class="wrap footer-bottom"><span>© 2026 Kakobuy Spreadsheet</span><a href="https://cnbuycha.com/" target="_blank" rel="noopener noreferrer">CnBuyCha <Icon name="external" size={12}/></a><span class="preview-label">{t.preview}</span></div></footer>
<script is:inline>
document.querySelectorAll('[data-photo]').forEach(button=>button.addEventListener('click',()=>{const image=document.getElementById('main-photo');image.src=button.dataset.photo;image.style.display='';document.getElementById('photo-link').href=button.dataset.photo;document.getElementById('photo-current').textContent=button.dataset.index;document.querySelectorAll('[data-photo]').forEach(b=>{b.classList.remove('selected');b.setAttribute('aria-pressed','false')});button.classList.add('selected');button.setAttribute('aria-pressed','true')}));
document.addEventListener('click',event=>{document.querySelectorAll('.language-menu[open]').forEach(menu=>{if(!menu.contains(event.target))menu.removeAttribute('open')})});
document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll('.language-menu').forEach(menu=>menu.removeAttribute('open'))});
</script>
</body></html>
