---
<!-- Google Analytics: dedicated KakobuyPick web stream, production only. -->
{production&&<>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6WXLRRCDS3"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-6WXLRRCDS3');
</script>
</>}
<script>
  import {installEngagementTracking} from '../scripts/engagement.js';
  installEngagementTracking(document,window.location,(name,params)=>{
    const analytics=(window as any).gtag;
    if(typeof analytics==='function')analytics('event',name,params);
  });
</script>
