---
import Icon from './Icon.astro';
import {localized} from '../lib/i18n';
import {slugs} from '../lib/catalog';
const {product:p,t,names,lang}=Astro.props;
const href=localized(lang,`/products${p.path}`);
---
<article class="product-card">
  <a class="card-image" href={href} aria-label={`${t.view}: ${p.title}`}>
    <span class="missing-image">{t.photoMissing}</span>
    {p.image && <img src={p.image} alt={p.title} width="600" height="600" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()"/>}
    <span class="card-arrow"><Icon name="arrow" size={18}/></span>
  </a>
  <div class="card-info"><span class="card-category">{names[slugs.indexOf(p.category)] || t.all}</span><a href={href}><h3>{p.title}</h3></a><div class="card-bottom"><span class="card-price">${p.price} <small>USD</small></span><a href={href} aria-label={`${t.view}: ${p.title}`}><Icon name="arrow" size={17}/></a></div></div>
</article>
