{
  "name": "itaobuygrid-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-20",
  "build": {
    "command": "node scripts/build.mjs"
  },
  "routes": [
    {
      "pattern": "itaobuygrid.com",
      "custom_domain": true
    },
    {
      "pattern": "www.itaobuygrid.com",
      "custom_domain": true
    }
  ]
}