---
import {home,listing,detail,slugs} from '../lib/catalog';
import {translateTitles,translationPending} from '../lib/translate';
import Card from '../components/Card.astro';
import texts from '../content/ui.json';
import editorial from '../content/editorial.json';
import '../styles/site.css';
const languages={en:'English',de:'Deutsch',fr:'Fran?ais',es:'Espa?ol',it:'Italiano',pt:'Portugu��s',pl:'Polski',zh:'��������'};
let parts=(Astro.params.path||'').split('/').filter(Boolean);const lang=parts[0] in languages?parts.shift():'en';const t=texts[lang];const prefix=lang==='en'?'':'/'+lang;const route=parts[0]||'home';
const content=editorial[lang];const article=parts[0]==='articles'&&parts[1]?content.articles.find(a=>a.slug===parts[1]):null;
const q=Astro.url.searchParams.get('q')||'';const category=Astro.url.searchParams.get('category')||'';const sort=['new','click','price'].includes(Astro.url.searchParams.get('sort'))?Astro.url.searchParams.get('sort'):'new';const page=Math.max(1,Number(Astro.url.searchParams.get('page'))||1);
let data=null,product=null,error=false;try{if(route==='home'||route==='categories')data=await home();if(route==='spreadsheet')data=await listing(category,q,sort,page);if(route==='product')product=await detail('/'+parts.slice(1).join('/').replace(/(?:\.html)?$/,'.html'));}catch(e){console.error('catalogue route',parts,e.message);error=true;Astro.response.status=e.status===404?404:503;}
const titleMap=await translateTitles([...(route==='home'?(data?.products||[]).slice(0,8):route==='spreadsheet'?(data?.products||[]):[]).map(p=>p.title),...(product?[product.title]:[])],lang);
if(data?.products)data.products=data.products.map(p=>({...p,localizedTitle:titleMap.get(p.title)||p.title}));
const known=['home','spreadsheet','categories','product','image-search','guides','faq','shipping','qc','articles'];if(!known.includes(route)||(route==='articles'&&parts[1]&&!article))Astro.response.status=404;
const title=article?article.title:product?titleMap.get(product.title)||product.title:route==='home'?'USFans Spreadsheet':(t[{spreadsheet:'sheet','image-search':'imageSearch',guides:'guide'}[route]||route]||'404');
const categories={en:['Shoes','Hoodies & sweaters','T-shirts','Jackets','Pants & shorts','Headwear','Accessories','Matching sets','Electronics','Other finds','Jerseys'],de:['Schuhe','Hoodies & Pullover','T-Shirts','Jacken','Hosen & Shorts','Kopfbedeckungen','Accessoires','Sets','Elektronik','Weitere Artikel','Trikots'],fr:['Chaussures','Sweats & pulls','T-shirts','Vestes','Pantalons & shorts','Couvre-chefs','Accessoires','Ensembles','��lectronique','Autres articles','Maillots'],es:['Zapatos','Sudaderas','Camisetas','Chaquetas','Pantalones','Gorras','Accesorios','Conjuntos','Electr��nica','Otros','Camisetas deportivas'],it:['Scarpe','Felpe & maglioni','T-shirt','Giacche','Pantaloni','Cappelli','Accessori','Completi','Elettronica','Altro','Maglie sportive'],pt:['Sapatos','Moletons','Camisetas','Jaquetas','Cal?as & shorts','Chap��us','Acess��rios','Conjuntos','Eletr?nicos','Outros','Camisas esportivas'],pl:['Buty','Bluzy & swetry','Koszulki','Kurtki','Spodnie','Czapki','Akcesoria','Zestawy','Elektronika','Inne','Koszulki sportowe'],zh:['Ь��','���� / ë��','T ��','�п�','���� / �̿�','ñ��','����','��װ','���Ӳ�Ʒ','������Ʒ','����']};
const catName=s=>categories[lang][slugs.indexOf(s)]||s;const link=r=>prefix+r;const pageLink=n=>{const params=new URLSearchParams(Astro.url.search);params.set('page',String(n));return link('/spreadsheet/')+'?'+params};
const id=product?.sourceUrl?new URL(product.sourceUrl).searchParams.get('itemID'):'';const encoded=id?encodeURIComponent(product.sourceUrl):'';
const canonical=new URL(Astro.url.pathname,'https://usfanstab.com');
if(route==='spreadsheet'){if(category)canonical.searchParams.set('category',category);if(page>1)canonical.searchParams.set('page',String(page));}
const noindex=Astro.response.status!==200||!!q||sort!=='new';
const localePath=Astro.url.pathname.replace(/^\/(en|de|fr|es|it|pt|pl|zh)(?=\/|$)/,'')||'/';
const agents=id? [['Oopbuy',`https://oopbuy.com/goods/details?id=${id}&channel=weidian`],['Superbuy',`https://www.superbuy.com/en/page/buy/?url=${encoded}`],['CSSBuy',`https://www.cssbuy.com/shop/goodsDetail?type=micro&id=${id}`],['Kakobuy',`https://kakobuy.com/item/details?url=${encoded}`],['Lovegobuy',`https://www.lovegobuy.com/product?id=${id}&shop_type=weidian`],['Sugargoo',`https://www.sugargoo.com/products?productLink=${encoded}`]]:[];
---
<!doctype html><html lang={lang==='zh'?'zh-CN':lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content={noindex?"noindex,follow":"index,follow,max-image-preview:large"}/><link rel="canonical" href={canonical.href}/>{Object.keys(languages).map(l=><link rel="alternate" hreflang={l==='zh'?'zh-CN':l} href={'https://usfanstab.com'+(l==='en'?'':'/'+l)+localePath+canonical.search}/>)}<link rel="alternate" hreflang="x-default" href={'https://usfanstab.com'+localePath+canonical.search}/><title>{title} | USFans Finds</title><meta name="description" content={article?.description||(route==='articles'?t.articlesIntro:t.intro)}/><link rel="icon" href="https://www.usfans.com/favicon.png"/>{(route==='faq'||article)&&<script type="application/ld+json" set:html={JSON.stringify(article?{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,dateModified:content.reviewed,author:{'@type':'Organization',name:'USFans Finds'},inLanguage:lang}:{'@context':'https://schema.org','@type':'FAQPage',mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}).replace(/</g,'\\u003c')}></script>}</head>
<body data-lang={lang} data-page={article?"article":route}><header class="header"><div class="header-inner"><a href={link('/')} class="brand" aria-label="USFans"><span class="brand-logo"><img src="https://media.usfans.com/webresource/v1/brand/6ebaf586041d4ff8ad34d66a35d3dc88.webp" alt="USFans" width="112" height="30"/></span><span class="brand-caption">FINDS</span></a><nav aria-label={t.categories}>{[['home','/'],['sheet','/spreadsheet/'],['categories','/categories/'],['imageSearch','/image-search/'],['faq','/faq/'],['articles','/articles/']].map(([key,path])=><a class:active={route==={home:'home',sheet:'spreadsheet',categories:'categories',imageSearch:'image-search',faq:'faq',articles:'articles'}[key]} href={link(path)}>{t[key]}</a>)}</nav><div class="controls"><label class="select-wrap"><span aria-hidden="true">��</span><select id="language" aria-label={t.languageLabel}>{Object.entries(languages).map(([code,name])=><option value={code} selected={code===lang}>{name}</option>)}</select></label><select id="currency" aria-label={t.currencyLabel}><option>USD</option>{['EUR','GBP','CNY','AUD','CAD','BRL','PLN','JPY','KRW','CHF','SEK','DKK','NOK','HKD','SGD','THB','IDR','CZK','HUF','RON','MXN','NZD'].map(c=><option>{c}</option>)}</select><a class="button small" href="https://www.usfans.com/register" target="_blank" rel="noopener">{t.join} �J</a></div></div></header>
<main>
{error?<section class="empty"><h1>{t.unavailable}</h1><a class="button" href={Astro.url.pathname+Astro.url.search}>{t.retry}</a></section>:null}
{!error&&route==='home'&&<>
<section class="hero"><div class="hero-copy"><p class="eyebrow">USFANS SPREADSHEET</p><h1>{t.hero}</h1><p class="intro">{t.intro}</p><form class="searchbar" action={link('/spreadsheet/')}><span aria-hidden="true">?</span><input name="q" aria-label={t.search} placeholder={t.placeholder}/><a href={link('/image-search/')} aria-label={t.imageSearch}><svg class="camera-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7.7 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.7z"/><circle cx="12" cy="13" r="4"/></svg></a><button>{t.search} ��</button></form><div class="hero-links"><a href={link('/spreadsheet/')}>{t.browse} �J</a><a href={link('/guides/')}>{t.guide} ��</a></div></div><div class="hero-products" aria-hidden="true">{data.products.slice(0,3).map((p,i)=><a href={link('/product'+p.path)} tabindex="-1" class={`hero-product hero-product-${i}`}><img src={p.image} alt="" referrerpolicy="no-referrer"/><span data-translate-title={translationPending(p.title,lang,p.localizedTitle)?p.title:undefined}>{p.localizedTitle}</span><strong data-usd={p.price}>${p.price}</strong></a>)}</div></section>
<section class="category-strip">{data.categories.slice(0,8).map(c=><a href={link('/spreadsheet/?category='+c.slug)}>{catName(c.slug)}<span>�J</span></a>)}</section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">USFANS FINDS</p><h2>{t.latest}</h2></div><a href={link('/spreadsheet/')}>{t.all} ��</a></div><div class="grid">{data.products.slice(0,8).map(p=><Card p={p} lang={lang} prefix={prefix}/>)}</div></section>
<section class="guide-panel"><div><p class="eyebrow">USFANS</p><h2>{t.guideTitle}</h2><a href={link('/guides/')}>{t.guide} ��</a></div><div class="steps">{[1,2,3].map(n=><article><span>0{n}</span><h3>{t['step'+n]}</h3><p>{t['step'+n+'Text']}</p></article>)}</div></section>
</>}
{!error&&route==='spreadsheet'&&<section class="section listing"><div class="section-heading"><div><p class="eyebrow">USFANS</p><h1>{category?catName(category):t.sheet}</h1></div><span>{data.total.toLocaleString()} {t.results}</span></div><form class="filters" action={link('/spreadsheet/')}><input name="q" value={q} placeholder={t.placeholder} aria-label={t.search}/><select name="category" aria-label={t.categories}><option value="">{t.allCategories}</option>{slugs.map(s=><option value={s} selected={category===s}>{catName(s)}</option>)}</select><select name="sort" aria-label={t.price}><option value="new" selected={sort==='new'}>{t.newest}</option><option value="click" selected={sort==='click'}>{t.popular}</option><option value="price" selected={sort==='price'}>{t.price}</option></select><button class="button">{t.search}</button></form><div class="grid">{data.products.map(p=><Card p={p} lang={lang} prefix={prefix}/>)}</div><nav class="pagination">{page>1&&<a href={pageLink(page-1)}>�� {t.previous}</a>}<span>{page} / {data.pages}</span>{page<data.pages&&<a href={pageLink(page+1)}>{t.next} ��</a>}</nav></section>}
{!error&&route==='categories'&&<section class="section"><p class="eyebrow">USFANS</p><h1>{t.categoryIntro}</h1><div class="category-grid">{data.categories.map((c,i)=><a href={link('/spreadsheet/?category='+c.slug)}><span class="category-number">{String(i+1).padStart(2,'0')}</span><h2>{catName(c.slug)}</h2><p>{c.count} {t.results}</p><span>�J</span></a>)}</div></section>}
{!error&&product&&<><div class="breadcrumbs"><a href={link('/spreadsheet/')}>{t.sheet}</a><span>/</span><a href={link('/spreadsheet/?category='+product.category)}>{catName(product.category)}</a></div><section class="detail"><div><div class="section-caption"><h2>{t.photos}</h2><span>{product.images.length}</span></div><button class="main-photo" data-enlarge><img id="main-photo" src={product.images[0]} alt={title} width="700" height="700" referrerpolicy="no-referrer"/><span>?</span></button><div class="thumbs">{product.images.map((im,i)=><button data-photo={im} aria-label={`${t.reference} ${i+1}`}><img src={im} alt="" referrerpolicy="no-referrer"/></button>)}</div></div><div class="product-info"><p class="eyebrow">USFANS FINDS</p><h1 data-translate-title={translationPending(product.title,lang,title)?product.title:undefined}>{title}</h1><p class="muted">WEIDIAN �� ID {id}</p><p class="detail-price" data-usd={product.price}>${product.price} <small>USD</small></p><p class="muted price-note">{t.priceNote}</p><p class="muted rate-status" data-rate-status></p>{product.buy&&<a class="button buy" href={product.buy} target="_blank" rel="sponsored noopener">{t.buy} �J</a>}<div class="action-row"><details class="agent-picker"><summary>{t.agents} <span>?</span></summary><div class="agent-list">{agents.map(([name,url])=><a href={url} target="_blank" rel="noopener">{name} �J</a>)}</div></details><button data-copy={product.sourceUrl}>{t.copy}</button></div><p class="muted" id="copy-status" role="status"></p><section class="styles"><h2>{t.styles}</h2><p id="style-status" class="muted" role="status">{t.loadingStyles}</p><div id="style-photos" class="style-grid" data-path={product.path} aria-label={t.styles}></div><p id="selected-style" class="muted" role="status"></p><a class="style-source" href={product.sourceUrl} target="_blank" rel="noopener">{t.viewStyles} �J</a></section></div></section><section class="section qc-section"><div class="section-caption"><h2>{t.qc}</h2><span>0</span></div><div class="empty-qc"><span><svg class="camera-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7.7 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.7z"/><circle cx="12" cy="13" r="4"/></svg></span><p>{t.noQc}</p><a href={link('/qc/')}>{t.qc} ��</a></div></section><section class="section"><h2>{t.gallery}</h2><div class="photo-row">{product.images.map(im=><button data-photo={im} data-open><img src={im} alt={title} loading="lazy" referrerpolicy="no-referrer"/></button>)}</div></section><dialog id="lightbox"><button class="close" aria-label={t.close}>��</button><img alt={title}/></dialog></>}
{route==='image-search'&&<section class="section image-page"><p class="eyebrow">USFANS</p><h1>{t.imageSearch}</h1><p class="intro">{t.imageHint}</p><div class="upload-box"><span class="upload-icon"><svg class="camera-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7.7 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.7z"/><circle cx="12" cy="13" r="4"/></svg></span><label class="button" for="image-file">{t.upload}</label><input type="file" id="image-file" accept="image/jpeg,image/png,image/webp"/><img id="upload-preview" hidden alt={t.reference}/><button class="button secondary" id="image-start" disabled>{t.start}</button></div><p id="index-coverage" class="muted"></p><p id="image-status" role="status"></p><div id="image-results" class="grid"></div></section>}
{['guides','qc','shipping'].includes(route)&&<section class="section prose"><p class="eyebrow">USFANS</p><h1>{title}</h1>{route==='guides'?<><p class="intro">{t.guideTitle}</p>{[1,2,3].map(n=><article><h2>{n}. {t['step'+n]}</h2><p>{t['step'+n+'Text']}</p></article>)}</>:<p class="intro">{route==='qc'?t.qcText:t.shippingText}</p>}<a class="button" href={link('/spreadsheet/')}>{t.browse} ��</a></section>}
{route==='faq'&&<section class="section faq-full"><p class="eyebrow">USFANS</p><h1>{t.faq}</h1><p class="review-date">{t.reviewed}: {content.reviewed}</p>{content.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p>{f.source&&<a class="faq-source" href={f.source} target="_blank" rel="noopener">{t.officialHelp} �J</a>}</details>)}</section>}
{route==='home'&&<section class="section faq"><div><p class="eyebrow">USFANS</p><h2>{t.faq}</h2><p><a href={link('/faq/')}>{t.allQuestions} ��</a></p></div><div>{content.faqs.slice(0,3).map(f=><details><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div></section>}
{(route==='home'||route==='articles'&&!parts[1])&&<section class="section"><div class="section-heading"><div><p class="eyebrow">USFANS</p>{route==='home'?<h2>{t.articlesTitle}</h2>:<h1>{t.articlesTitle}</h1>}<p class="intro">{t.articlesIntro}</p></div>{route==='home'&&<a href={link('/articles/')}>{t.allArticles} ��</a>}</div><div class="article-grid">{content.articles.slice(0,route==='home'?3:10).map(a=><a class="article-card" href={link('/articles/'+a.slug+'/')}><p class="eyebrow">USFANS</p><h2>{a.title}</h2><p>{a.description}</p><span>{t.readGuide} ��</span></a>)}</div></section>}
{article&&<article class="article-body"><div class="breadcrumbs"><a href={link('/articles/')}>{t.articles}</a><span>/</span><span>USFans</span></div><h1>{article.title}</h1><p class="intro">{article.description}</p><p class="review-date">{t.reviewed}: {content.reviewed} �� USFans Finds</p><details class="article-toc"><summary>{t.toc}</summary>{article.sections.map((s,i)=><a href={'#section-'+i}>{i+1}. {s.heading}</a>)}</details>{article.sections.map((s,i)=><details class="article-section" id={'section-'+i} open={i===0}><summary><h2>{s.heading}</h2></summary>{s.paragraphs.map(p=><p>{p}</p>)}</details>)}<aside class="article-sources"><h2>{t.sources}</h2>{article.sources.map(u=><a href={u} target="_blank" rel="noopener">{new URL(u).pathname.replace('/help/','USFans Help �� ').replace('/page/','USFans �� ')} �J</a>)}<p><a href={link('/faq/')}>{t.faq} ��</a></p><a class="button" href={link('/spreadsheet/')}>{t.browse} ��</a></aside></article>}
{route==='articles'&&parts[1]&&!article&&<section class="empty"><h1>404</h1><a href={link('/articles/')}>{t.allArticles}</a></section>}
{!known.includes(route)&&<section class="empty"><h1>404</h1><a href={link('/')}>{t.home}</a></section>}
</main><footer><div><a class="footer-brand" href={link('/')}>USFans <span>FINDS</span></a><p>{t.independent}</p></div><nav>{[['sheet','spreadsheet'],['guide','guides'],['qc','qc'],['shipping','shipping'],['faq','faq'],['articles','articles']].map(([k,r])=><a href={link('/'+r+'/')}>{t[k]}</a>)}</nav><p>? 2026 USFans Finds</p></footer>
<script type="application/json" id="ui-data" set:html={JSON.stringify({t,lang,prefix}).replace(/</g,'\\u003c')}></script><script>import '../scripts/client';</script></body></html>
