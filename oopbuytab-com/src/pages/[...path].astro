---
import Icon from '../components/Icon.astro';
import Card from '../components/Card.astro';
import Sources from '../components/Sources.astro';
import {languages,translate,categoryNames,localized} from '../lib/i18n';
import {editorial} from '../lib/copy';
import {contentFor} from '../lib/editorial';
import {home,listing,detail,slugs,LOGO,FAVICON,REGISTER} from '../lib/catalog';
import '../styles/global.css';

const parts=Astro.url.pathname.split('/').filter(Boolean);
const lang=languages.some(([code])=>code===parts[0])?parts.shift()!:'en';
const localPath='/'+parts.join('/')+(parts.length&&!parts.at(-1)!.includes('.')?'/':'');
const route=(path:string)=>localized(lang,path);
const t=translate(lang),c=editorial(lang),e=contentFor(lang),u=e.ui,names=categoryNames(lang);
const query=(Astro.url.searchParams.get('q')||'').trim().slice(0,120);
const isHome=parts.length===0,isFinds=parts.length===1&&parts[0]==='finds';
const category=parts.length===2&&parts[0]==='category'&&slugs.includes(parts[1])?parts[1]:'';
const isCatalog=!!category||(parts.length===1&&parts[0]==='spreadsheet')||isFinds;
const isProduct=parts.length===3&&parts[0]==='products'&&slugs.includes(parts[1])&&/^\d+\.html$/.test(parts[2]);
const isVisual=parts.length===1&&parts[0]==='image-search';
const isGuide=localPath==='/guide/',isFAQ=localPath==='/faq/',isJournal=localPath==='/articles/',isQC=localPath==='/qc/',isShipping=localPath==='/shipping/';
const article=parts.length===2&&parts[0]==='articles'?e.articles.find(a=>a.slug===parts[1]):undefined;
const known=isHome||isCatalog||isProduct||isVisual||isGuide||isFAQ||isJournal||isQC||isShipping||!!article;
const sort=['new','click','price'].includes(Astro.url.searchParams.get('sort')||'')?Astro.url.searchParams.get('sort')!:(isFinds?'click':'new');
const page=Math.max(1,Math.min(1000,parseInt(Astro.url.searchParams.get('page')||'1')||1));
let products:any[]=[],categories:any[]=[],total=0,pages=1,product:any=null,error=false;
try{
 if(isHome){const data=await home();products=data.products;categories=data.categories;total=categories.reduce((n,x)=>n+x.count,0);}
 if(isCatalog){const data=await listing(category,query,sort,page);({products,total,pages}=data);if(page>pages)Astro.response.status=404;}
 if(isProduct)product=await detail('/'+parts.slice(1).join('/'));
}catch(err){error=true;console.error('CNBuyCha:',err instanceof Error?err.message:'request failed');if(!isHome)Astro.response.status=503;}
if(!known)Astro.response.status=404;
const preview=import.meta.env.OOPBUY_PRODUCTION!=='true';
const robots=preview?'noindex,nofollow':(!known||(error&&!isHome)||isVisual||query||page>1||Astro.url.searchParams.has('sort'))?'noindex,follow':'index,follow,max-image-preview:large';
Astro.response.headers.set('X-Robots-Tag',robots);
const state=(changes:Record<string,string|number>)=>{const p=new URLSearchParams();if(query)p.set('q',query);if(sort!=='new'||isFinds)p.set('sort',sort);if(page>1)p.set('page',String(page));for(const[k,v]of Object.entries(changes)){if(v==='')p.delete(k);else p.set(k,String(v));}return p.size?'?'+p.toString():'';};
const categoryCopy=(e as any).categoryIntros?.[category];
const guideContent=(e as any).guides?.[isGuide?'guide':isQC?'qc':isShipping?'shipping':''];
const pageTitle=product?.title||article?.title||(isHome?u.homeSeoTitle:isGuide?u.guideTitle:isFAQ?u.faqTitle:isJournal?u.articlesTitle:isQC?u.qcTitle:isShipping?u.shippingTitle:isVisual?t.visual:isFinds?u.findsTitle:category?(categoryCopy?.title||`${names[slugs.indexOf(category)]} · OOPBuy`):query?`${t.search}: ${query}`:'OOPBuy Spreadsheet');
const intro=(product?`${product.title} · OOPBuy. ${c.priceNote}`:undefined)||article?.description||(isVisual?c.visualNote:undefined)||categoryCopy?.intro||(isGuide?u.guideIntro:isFAQ?u.faqIntro:isJournal?u.articlesIntro:isQC?u.qcIntro:isShipping?u.shippingIntro:isFinds?u.findsIntro:isCatalog?u.spreadsheetIntro:u.heroIntro);
const origin=Astro.site!.origin,canonical=origin+route(localPath);
const nav=[['/',t.home],['/spreadsheet/',t.browse],['/finds/',u.finds],['/guide/',t.guide],['/qc/',u.qc],['/shipping/',u.shipping],['/faq/',t.faq],['/articles/',u.articles]];
const icons=['shoe','shirt','shirt','jacket','pants','hat','bag','shirt','device','box','shirt'];
const reading=article;
const reviewed=article?.modified||'2026-10-21';
const published=article?.published||reviewed;
const paragraphs=(text:string)=>text.split(/\n\s*\n/).filter(Boolean);
const articleRelated=article?(article as any).related?.map((slug:string)=>e.articles.find(a=>a.slug===slug)).filter(Boolean):[];
const schema={ '@context':'https://schema.org', '@type':article?'Article':isHome?'WebSite':'WebPage',name:pageTitle,url:canonical,inLanguage:lang,description:intro,...(article?{headline:article.title,author:{'@type':'Organization',name:'OOPBuy Tab'},dateModified:reviewed,datePublished:published,mainEntityOfPage:canonical}:{})};
const breadcrumbSchema=article?{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:t.home,item:origin+route('/')},{'@type':'ListItem',position:2,name:u.articles,item:origin+route('/articles/')},{'@type':'ListItem',position:3,name:article.title,item:canonical}]}:null;
const faqSchema=isFAQ?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:e.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}:null;
const pagination=[...new Set([1,page-1,page,page+1,pages].filter(n=>n>=1&&n<=pages))].sort((a,b)=>a-b);
---
<!doctype html>
<html lang={lang}>
<head>
 {!preview&&<>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CC6HPXJJN7"></script>
  <script is:inline>
   window.dataLayer = window.dataLayer || [];
   function gtag(){dataLayer.push(arguments);}
   gtag('js', new Date());
   gtag('config', 'G-CC6HPXJJN7');
  </script>
 </>}
 {!preview&&<script is:inline src="/analytics-events.js" defer></script>}
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <title>{pageTitle}{article?'':' · OOPBuy Tab'}</title><meta name="description" content={intro}/><meta name="robots" content={robots}/>
 <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
 {breadcrumbSchema&&<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g,'\\u003c')}/>}
 {faqSchema&&<script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g,'\\u003c')}/>}
 <meta name="theme-color" content="#ff186b"/><link rel="icon" type="image/png" href={FAVICON}/><link rel="canonical" href={canonical}/>
 {languages.map(([code])=><link rel="alternate" hreflang={code} href={origin+localized(code,localPath)}/>)}<link rel="alternate" hreflang="x-default" href={origin+localPath}/>
 <meta property="og:title" content={pageTitle}/><meta property="og:description" content={intro}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/>
 <link rel="preconnect" href="https://cnbuycha.com"/><link rel="preconnect" href="https://si.geilicdn.com"/>
</head>
<body data-locale={lang} data-article={article?.slug||undefined} data-product={product?.sourceId||undefined}>
<header class="site-header">
 <div class="topbar wrap">
  <a class="brand" href={route('/')} aria-label="OOPBuy Tab"><img src={LOGO} width="134" height="48" alt="OOPBuy"/><span class="brand-tab">tab<span class="brand-dot">.</span></span></a>
  <form class="header-search" action={route('/spreadsheet/')} role="search"><Icon name="search" size={17}/><input name="q" type="search" value={query} placeholder={t.placeholder} aria-label={t.search}/><button type="submit" aria-label={t.search}><Icon name="arrow" size={17}/></button></form>
  <div class="header-actions"><details class="language-menu"><summary aria-label={t.language}><Icon name="globe" size={17}/>{lang.toUpperCase()}<Icon name="chevron" size={12}/></summary><div class="language-panel"><div class="language-title">{t.language}<span>24</span></div><input class="language-filter" type="search" placeholder={t.search} aria-label={t.language}/><div class="language-grid">{languages.map(([code,name])=><a lang={code} hreflang={code} class:list={{selected:code===lang}} href={localized(code,localPath)+state({})}>{name}<small>{code.toUpperCase()}</small></a>)}</div></div></details><a class="button primary join" href={REGISTER} target="_blank" rel="noopener noreferrer">{t.register}<Icon name="external" size={14}/></a></div>
 </div>
 <div class="nav-row"><div class="wrap nav-inner"><nav class="desktop-nav" aria-label={t.browse}>{nav.map(([path,label])=><a class:list={{active:localPath===path||(path==='/spreadsheet/'&&(isProduct||category))||(path==='/articles/'&&article)}} href={route(path)}>{label}</a>)}</nav><details class="mobile-nav"><summary><Icon name="grid" size={17}/>{t.browse}<Icon name="chevron" size={14}/></summary><nav aria-label={t.browse}>{nav.map(([path,label])=><a href={route(path)} class:list={{active:localPath===path}}>{label}<Icon name="arrow" size={14}/></a>)}</nav></details>{preview&&<span class="preview"><span></span>{u.previewLabel}</span>}</div></div>
</header>
<main>
{isHome&&<>
 <section class="hero wrap">
  <div class="hero-copy"><span class="eyebrow"><i></i>{u.heroLabel}</span><h1>OOPBuy<br/><span>Spreadsheet.</span></h1><p>{u.heroIntro}</p><div class="hero-buttons"><a class="button primary" href={route('/spreadsheet/')}>{u.browseAll}<Icon name="arrow" size={19}/></a><a class="text-link" href={route('/guide/')}>{t.guide}<Icon name="arrow" size={17}/></a></div><div class="hero-note"><span class="tiny-check"><Icon name="check" size={12}/></span>{u.heroNote}</div></div>
  <div class="hero-display"><div class="display-heading"><span>{u.heroLine.split('\n')[0]}</span><span>{u.heroLine.split('\n')[1]}</span></div><div class="hero-products">{products.slice(0,3).map((p,i)=><a class:list={['hero-product',`hero-product-${i}`]} href={route(`/products${p.path}`)}><div class="hero-product-image">{p.image?<img src={p.image} alt={p.title} width="520" height="520" fetchpriority={i===0?'high':'auto'} referrerpolicy="no-referrer" onerror="this.remove()"/>:<Icon name={icons[slugs.indexOf(p.category)]} size={60}/>}<span class="pick-number">0{i+1}</span></div><div class="hero-product-caption"><span>{p.title}</span><b>${p.price}</b></div><span class="hero-product-arrow"><Icon name="arrow" size={17}/></span></a>)}{error&&<div class="hero-unavailable"><Icon name="grid" size={54}/><p>{t.unavailable}</p><a href={Astro.url.pathname} class="text-link">{t.retry}<Icon name="arrow"/></a></div>}</div><div class="display-footer"><span>{u.catalogSource}</span><Icon name="arrow" size={18}/></div></div>
 </section>
 <section class="category-section wrap"><div class="mini-heading"><span>{u.categoryTitle}</span><a href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={15}/></a></div><div class="category-grid">{slugs.slice(0,7).map((slug,i)=><a href={route(`/category/${slug}/`)}><span class="category-icon"><Icon name={icons[i]} size={26}/></span><span>{names[i]}</span>{categories.find(c=>c.slug===slug)&&<small>{categories.find(c=>c.slug===slug).count}</small>}</a>)}<a href={route('/spreadsheet/')}><span class="category-icon dark"><Icon name="grid" size={24}/></span><span>{t.all}</span><small>→</small></a></div></section>
 <section class="section wrap"><div class="section-heading"><div><span class="eyebrow muted">{u.finds}</span><h2>{u.featured}</h2><p>{u.featuredIntro}</p></div><a class="text-link" href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={18}/></a></div>{error?<div class="empty-state"><Icon name="box" size={34}/><h3>{t.unavailable}</h3><p>{c.error}</p><a class="button outline" href={route('/')}>{t.retry}</a></div>:<div class="product-grid">{products.slice(0,8).map(p=><Card product={p} t={t} names={names} lang={lang}/>)}</div>}</section>
 <section class="steps-band"><div class="wrap steps-layout"><div class="steps-intro"><span class="eyebrow">{t.guide}</span><h2>{u.guideTitle}</h2><a href={route('/guide/')} class="text-link">{t.guide}<Icon name="arrow" size={18}/></a></div><div class="steps">{e.steps.map((step,i)=><div><span class="step-number">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></div>)}</div></div></section>
 <section class="section wrap"><div class="section-heading"><div><span class="eyebrow muted">{u.articles}</span><h2>{u.latestReading}</h2></div><a class="text-link" href={route('/articles/')}>{u.allArticles}<Icon name="arrow" size={18}/></a></div><div class="article-grid">{e.articles.slice(0,4).map((a,i)=><a class="article-card" href={route(`/articles/${a.slug}/`)}><div class="article-art" data-tone={i}><span class="article-index">{String(i+1).padStart(2,'0')}</span><Icon name={['grid','camera','box','shirt'][i]} size={46}/><span class="article-mark">↗</span></div><span class="eyebrow muted">{a.tag}</span><h3>{a.title}</h3><p>{a.description}</p><span class="text-link">{u.read}<Icon name="arrow" size={16}/></span></a>)}</div></section>
 <section class="home-faq wrap"><div><span class="eyebrow muted">FAQ</span><h2>{u.faqTitle}</h2><a class="text-link" href={route('/faq/')}>{t.faq}<Icon name="arrow" size={17}/></a></div><div class="faq-list">{e.faq.slice(0,3).map(f=><details><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div></section>
</>}
{isCatalog&&<>
 <section class="page-intro wrap"><a class="breadcrumb" href={route('/')}>{t.home} <span>/</span> {t.browse}</a><span class="eyebrow muted">OOPBUY TAB</span><h1>{pageTitle}</h1><p>{intro}</p>{categoryCopy&&<details class="category-checks"><summary>{(u as any).quickChecks}<Icon name="chevron" size={14}/></summary><ul>{categoryCopy.checks.map((item:string)=><li>{item}</li>)}</ul><a class="text-link" href={route('/articles/oopbuy-sizing-guide/')}>{(u as any).moreDetails}<Icon name="arrow" size={14}/></a></details>}<form class="search-form" action={route(localPath)} role="search"><Icon name="search" size={21}/><input name="q" type="search" value={query} placeholder={t.placeholder} aria-label={t.search}/><input type="hidden" name="sort" value={sort}/><button type="submit" aria-label={t.search}><Icon name="arrow" size={20}/></button></form><div class="search-subline"><span>{u.searchHelp}</span><a href={route('/image-search/')}><Icon name="camera" size={15}/>{t.visual}</a></div></section>
 <section class="catalog-layout wrap"><aside><details class="category-menu" open><summary>{t.categories}<Icon name="chevron" size={15}/></summary><nav aria-label={t.categories}><a href={route(isFinds?'/finds/':'/spreadsheet/')+state({page:''})} class:list={{selected:!category}}><Icon name="grid" size={18}/>{t.all}</a>{slugs.map((slug,i)=><a class:list={{selected:category===slug}} href={route(`/category/${slug}/`)+state({page:''})}><Icon name={icons[i]} size={18}/>{names[i]}</a>)}</nav></details><div class="sidebar-note"><Icon name="camera" size={23}/><h3>{u.photoLabel}</h3><p>{c.qcNote}</p><a class="text-link" href={route('/qc/')}>{u.qc}<Icon name="arrow" size={14}/></a></div></aside><div class="catalog-results" data-category={category||'all'} data-sort={sort} data-page={page} data-pages={pages} data-total={total} data-lang={lang} data-categories={JSON.stringify(Object.fromEntries(slugs.map((slug,i)=>[slug,names[i]])))} data-pagination-labels={JSON.stringify({previous:t.previous,next:t.next,view:t.view,photoMissing:t.photoMissing,page:(u as any).pageLabel||'Page',jump:(u as any).jumpToPage||'Go to page',go:(u as any).goToPage||'Go',loading:(u as any).loading||'Loading…',error:(u as any).loadError||'Could not load this page.',retry:t.retry})}><div class="catalog-toolbar"><span><b>{total.toLocaleString(lang)}</b> {t.results}{query&&<span class="query-label"> · “{query}”</span>}</span><form class="catalog-sort" method="get"><input type="hidden" name="q" value={query}/><select name="sort" aria-label={t.priceSort} onchange="this.form.requestSubmit()"><option value="new" selected={sort==='new'}>{t.latest}</option><option value="click" selected={sort==='click'}>{t.popular}</option><option value="price" selected={sort==='price'}>{t.priceSort}</option></select><noscript><button>{t.search}</button></noscript></form></div>{error?<div class="empty-state"><Icon name="box" size={34}/><h2>{t.unavailable}</h2><p>{c.error}</p><a class="button primary" href={route(localPath)+state({})}>{t.retry}</a></div>:products.length?<div class="product-grid">{products.map(p=><Card product={p} t={t} names={names} lang={lang}/>)}</div>:<div class="empty-state"><Icon name="search" size={34}/><h2>{t.empty}</h2><a class="button outline" href={route('/spreadsheet/')}>{t.clear}</a></div>}{!error&&<nav class="pagination" aria-label={t.browse}>
 <div class="pagination-main">
 {page>1?<a class="page-prev" aria-label={t.previous} href={route(localPath)+state({page:page-1})}>←<span class="page-direction-label">{t.previous}</span></a>:<span class="page-disabled page-prev" aria-disabled="true">←<span class="page-direction-label">{t.previous}</span></span>}
 <div class="page-numbers">{pagination.map((n,i)=><>{i>0&&n-pagination[i-1]>1&&<span class="ellipsis">…</span>}<a class:list={{current:n===page}} aria-current={n===page?'page':undefined} href={route(localPath)+state({page:n})}>{n}</a></>)}</div>
 {page<pages?<a class="page-next" aria-label={t.next} href={route(localPath)+state({page:page+1})}><span class="page-direction-label">{t.next}</span>→</a>:<span class="page-disabled page-next" aria-disabled="true"><span class="page-direction-label">{t.next}</span>→</span>}
 </div><form class="pagination-jump" action={route(localPath)} method="get"><input type="hidden" name="sort" value={sort}/>{query&&<input type="hidden" name="q" value={query}/>}<label>{(u as any).jumpToPage}<input type="number" name="page" min="1" max={pages} value={page} required aria-label={(u as any).jumpToPage}/></label><span class="page-total">/ {pages}</span><button type="submit">{(u as any).goToPage}</button></form>
 </nav>}</div></section>
</>}
{isProduct&&<section class="product-page wrap"><a class="breadcrumb" href={route(`/category/${parts[1]}/`)}>← {names[slugs.indexOf(parts[1])]}</a>{product?<><div class="product-detail"><div class="gallery"><a class="main-photo" id="photo-link" href={product.images[0]||undefined} target="_blank" rel="noopener noreferrer"><span class="missing-image">{t.photoMissing}</span>{product.images[0]&&<img id="main-photo" src={product.images[0]} alt={product.title} width="800" height="800" fetchpriority="high" referrerpolicy="no-referrer" onerror="this.style.display='none';this.parentElement.classList.add('photo-failed')"/>}<span class="photo-count"><Icon name="camera" size={15}/><span id="photo-current">{product.images.length?1:0}</span> / {product.images.length}</span></a><div class="thumbnails">{product.images.map((src:string,i:number)=><button type="button" data-photo={src} data-index={i+1} aria-label={`${t.photos} ${i+1}`} aria-pressed={i===0} class:list={{selected:i===0}}><img src={src} alt={`${product.title} ${i+1}`} width="80" height="80" loading="lazy" referrerpolicy="no-referrer"/></button>)}</div></div><div class="detail-info"><span class="eyebrow muted">{names[slugs.indexOf(product.category)]}</span><h1>{product.title}</h1><span class="source-id">ID · {product.sourceId}</span><div class="detail-price"><span>{t.price}</span><strong>${product.price}<small>USD</small></strong></div><p class="price-note">{c.priceNote}</p>{product.buy&&<a class="button primary purchase" href={product.buy} target="_blank" rel="sponsored nofollow noopener noreferrer">{t.buy}<Icon name="external" size={19}/></a>}{product.sourceUrl&&<a class="button outline purchase" href={product.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">{t.source}<Icon name="external" size={16}/></a>}<div class="detail-note"><Icon name="camera" size={22}/><div><h3>{t.photos}</h3><p>{c.qcNote}</p><a class="text-link" href={route('/qc/')}>{u.qc}<Icon name="arrow" size={14}/></a></div></div><a class="detail-shipping" href={route('/shipping/')}><Icon name="box" size={20}/>{u.shippingTitle}<Icon name="arrow" size={16}/></a></div></div>{product.related.length>0&&<section class="section"><div class="section-heading"><h2>{t.related}</h2><a class="text-link" href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={17}/></a></div><div class="product-grid">{product.related.map((p:any)=><Card product={p} t={t} names={names} lang={lang}/>)}</div></section>}</>:<div class="empty-state"><h1>{t.unavailable}</h1><p>{c.error}</p><a class="button primary" href={route(localPath)}>{t.retry}</a></div>}</section>}
{(isGuide||isQC||isShipping||isFAQ||isJournal||reading)&&<>
 <section class="page-intro editorial-intro wrap"><div class="breadcrumb"><a href={route('/')}>{t.home}</a><span>/</span>{article?<a href={route('/articles/')}>{u.articles}</a>:<span>{pageTitle}</span>}</div><span class="eyebrow muted">{article?.tag||'OOPBUY TAB'}</span><h1>{pageTitle}</h1><p>{intro}</p></section>
 {guideContent&&<section class="guide-page compact-guide wrap"><div class="guide-steps">{guideContent.sections.map((section:any,i:number)=><details class="guide-block" open><summary><span class="step-number">{String(i+1).padStart(2,'0')}</span><h2>{section.title}</h2><span class="expand-symbol">+</span></summary><div>{paragraphs(section.text).map(text=><p>{text}</p>)}</div></details>)}<Sources sources={guideContent.sources} label={(u as any).sources}/></div><aside class="guide-aside"><span class="eyebrow">{(u as any).quickChecks}</span><ul>{guideContent.checks.map((item:string)=><li>{item}</li>)}</ul>{isShipping?<a class="button primary" href="https://oopbuy.com/estimation" target="_blank" rel="noopener noreferrer">{u.shippingEstimator}<Icon name="external" size={16}/></a>:<a class="button primary" href={route('/spreadsheet/')}>{t.browse}<Icon name="arrow" size={17}/></a>}<a class="text-link" href={route(`/articles/${isQC?'oopbuy-qc-photos':isShipping?'oopbuy-shipping-guide':'oopbuy-spreadsheet-guide'}/`)}>{(u as any).moreDetails}<Icon name="arrow" size={15}/></a></aside></section>}

 {isFAQ&&<section class="faq-page wrap"><form class="faq-search search-form" onsubmit="return false"><Icon name="search"/><input id="faq-search" type="search" placeholder={t.search} aria-label={t.search}/></form><div class="faq-list">{e.faq.map((f,i)=><details class="faq-answer" open={i===0}><summary>{f.q}<span>+</span></summary><div class="faq-answer-body"><p>{f.a}</p><Sources sources={(f as any).sources} label={(u as any).sources}/></div></details>)}</div><p id="faq-empty" hidden>{t.empty}</p></section>}
 {isJournal&&<section class="section journal wrap"><div class="article-grid">{e.articles.map((a,i)=><a class="article-card" href={route(`/articles/${a.slug}/`)}><div class="article-art" data-tone={i%4}><span class="article-index">{String(i+1).padStart(2,'0')}</span><Icon name={['grid','camera','box','shirt','external','search','box','check','arrow','bag'][i%10]} size={46}/><span class="article-mark">↗</span></div><span class="eyebrow muted">{a.tag}</span><h2>{a.title}</h2><p>{a.description}</p><span class="text-link">{u.read}<Icon name="arrow" size={16}/></span></a>)}</div></section>}
 {reading&&<>
 <section class="article-summary wrap"><div class="article-meta"><span>{(u as any).lastReviewed}: <time datetime={reviewed}>{new Intl.DateTimeFormat(lang,{dateStyle:'medium'}).format(new Date(reviewed+'T12:00:00Z'))}</time></span><span>{Math.ceil(reading.sections.reduce((n,s)=>n+s.text.split(/\s+/).length,0)/220)} min</span></div><ul>{(reading as any).takeaways?.map((item:string)=><li>{item}</li>)}</ul></section>
 <section class="reading-layout wrap"><aside class="reading-toc"><details open><summary>{(u as any).contents}<Icon name="chevron" size={14}/></summary><nav>{reading.sections.map((section,i)=><a href={`#section-${i}`}>{String(i+1).padStart(2,'0')}<span>{section.title}</span></a>)}</nav></details><a class="text-link" href={route('/spreadsheet/')}>{t.browse}<Icon name="arrow" size={16}/></a></aside><article class="reading-body"><div class="reading-controls"><button type="button" data-expand-reading>{(u as any).expandAll}</button><button type="button" data-collapse-reading>{(u as any).collapseAll}</button></div>{reading.sections.map((section,i)=><details class="reading-section" id={`section-${i}`} open><summary><span class="step-number">{String(i+1).padStart(2,'0')}</span><h2>{section.title}</h2><span class="expand-symbol">+</span></summary><div class="section-prose">{paragraphs(section.text).map(text=><p>{text}</p>)}{i%3===1&&articleRelated?.[Math.floor(i/3)]&&<a class="section-next text-link" href={route(`/articles/${articleRelated[Math.floor(i/3)].slug}/`)}>{articleRelated[Math.floor(i/3)].title}<Icon name="arrow" size={16}/></a>}</div></details>)}<nav class="article-actions" aria-label={u.related}><a class="button primary" href={route('/spreadsheet/')} data-article-action="catalog">{u.browseAll}<Icon name="arrow" size={16}/></a><a class="button outline" href="https://oopbuy.com/estimation" target="_blank" rel="noopener noreferrer" data-article-action="estimator">{u.shippingEstimator}<Icon name="external" size={16}/></a></nav><Sources sources={(reading as any).sources} label={(u as any).sources}/><div class="reading-note"><Icon name="check" size={20}/><p>{c.disclosure}</p></div></article></section>
 {articleRelated?.length>0&&<section class="article-related wrap"><h2>{u.related}</h2><div>{articleRelated.map((item:any)=><a href={route(`/articles/${item.slug}/`)}>{item.title}<Icon name="arrow" size={16}/></a>)}</div></section>}
 </>}

 {!reading&&<section class="related-reading wrap"><h2>{u.related}</h2><div>{[[route('/spreadsheet/'),u.browseAll],[route(isQC?'/shipping/':'/qc/'),isQC?u.shipping:u.qc],[route('/articles/'),u.allArticles]].map(([href,label])=><a href={href}>{label}<Icon name="arrow" size={19}/></a>)}</div></section>}
</>}
{isVisual&&<section class="visual-page wrap"><div class="visual-box"><span class="icon-disc"><Icon name="camera" size={36}/></span><span class="eyebrow muted">{t.unavailable}</span><h1>{t.visual}</h1><p>{c.visualNote}</p><form class="search-form" action={route('/spreadsheet/')}><Icon name="search"/><input name="q" type="search" placeholder={t.placeholder} aria-label={t.search}/><button aria-label={t.search}><Icon name="arrow"/></button></form><a class="text-link" href={route('/spreadsheet/')}>{t.all}<Icon name="arrow" size={16}/></a></div></section>}
{!known&&<section class="empty-state wrap"><h1>404</h1><a class="button primary" href={route('/')}>{t.home}</a></section>}
</main>
<footer class="site-footer"><div class="wrap footer-main"><div class="footer-brand"><a class="brand" href={route('/')}><img src={LOGO} alt="OOPBuy" width="134" height="48"/><span class="brand-tab">tab<span class="brand-dot">.</span></span></a><p>{c.disclosure}</p></div><nav aria-label={t.browse}>{nav.slice(1).map(([path,label])=><a href={route(path)}>{label}</a>)}</nav></div><div class="wrap footer-bottom"><span>© 2026 OOPBuy Tab <span class="footer-separator">/</span> {u.independent}</span><a href="https://cnbuycha.com/" target="_blank" rel="noopener noreferrer">{u.catalogSource}<Icon name="external" size={12}/></a></div></footer>
<script is:inline>
document.addEventListener('click',event=>{document.querySelectorAll('.language-menu[open]').forEach(menu=>{if(!menu.contains(event.target))menu.removeAttribute('open')})});
document.addEventListener('keydown',event=>{if(event.key==='Escape')document.querySelectorAll('.language-menu,.mobile-nav').forEach(menu=>menu.removeAttribute('open'))});
document.querySelector('.language-filter')?.addEventListener('input',event=>{const q=event.target.value.toLocaleLowerCase();document.querySelectorAll('.language-grid a').forEach(a=>{a.hidden=!a.textContent.toLocaleLowerCase().includes(q)})});
document.querySelectorAll('[data-photo]').forEach(button=>button.addEventListener('click',()=>{const image=document.getElementById('main-photo');if(!image)return;image.src=button.dataset.photo;image.style.display='';document.getElementById('photo-link').classList.remove('photo-failed');document.getElementById('photo-link').href=button.dataset.photo;document.getElementById('photo-current').textContent=button.dataset.index;document.querySelectorAll('[data-photo]').forEach(b=>{b.classList.remove('selected');b.setAttribute('aria-pressed','false')});button.classList.add('selected');button.setAttribute('aria-pressed','true')}));
const faqSearch=document.getElementById('faq-search');faqSearch?.addEventListener('input',()=>{const q=faqSearch.value.trim().toLocaleLowerCase();let count=0;document.querySelectorAll('.faq-answer').forEach(item=>{const match=item.textContent.toLocaleLowerCase().includes(q);item.hidden=!match;if(match)count++;if(q&&match)item.open=true});document.getElementById('faq-empty').hidden=count>0});
document.querySelector('[data-expand-reading]')?.addEventListener('click',()=>document.querySelectorAll('.reading-section').forEach(section=>section.open=true));
document.querySelector('[data-collapse-reading]')?.addEventListener('click',()=>document.querySelectorAll('.reading-section').forEach(section=>section.open=false));
document.querySelectorAll('.reading-toc a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{const section=document.querySelector(link.getAttribute('href'));if(section)section.open=true}));
if(window.matchMedia('(max-width:760px)').matches){document.querySelectorAll('.reading-section,.reading-toc details,.faq-answer').forEach(section=>section.open=false);document.querySelectorAll('.guide-block').forEach((section,i)=>section.open=i===0);}
const mq=window.matchMedia('(max-width:760px)');const categoryMenu=document.querySelector('.category-menu');function syncCategory(){if(categoryMenu)categoryMenu.open=!mq.matches}syncCategory();mq.addEventListener('change',syncCategory);
</script>
</body>
</html>
